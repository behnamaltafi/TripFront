@using AntDesign

@inject NavigationManager NavigationManager

@rendermode InteractiveServer
 <Sider Width="200" Class="site-layout-background">
            <Menu Mode="MenuMode.Inline"
                  DefaultSelectedKeys=@(new[] {"1"})
                  DefaultOpenKeys=@(new[] {"sub1"})
                  Style="height: 100%; border-right: 0;">
                @{
                    RenderFragment sub1Title =
                    @<span>
                        <Icon Type="@IconType.Outline.User" />
                       دوستان
                    </span>;
                }
                <SubMenu Key="sub1" TitleTemplate=sub1Title>
                    <AuthorizeView>
                               <MenuItem RouterLink="/friend-requests" Key="1">درخواست ها</MenuItem>
                    </AuthorizeView>
             

                </SubMenu>
                @{
                    RenderFragment sub2Title =
                    @<span>
                        <Icon Type="@IconType.Outline.Flag" />
                        سفر ها
                    </span>;
                }
                <SubMenu Key="sub2" TitleTemplate=sub2Title>
                     <AuthorizeView>
                    <MenuItem RouterLink="/trips" Key="5">سفر</MenuItem>
                     </AuthorizeView>
               
                </SubMenu>
                @{
                    RenderFragment sub3Title =
                    @<span>
                        <Icon Type="@IconType.Outline.User" />
                        کاربری
                    </span>;
                }
                <SubMenu Key="sub3" TitleTemplate=sub3Title>
                    <AuthorizeView>

               
                    <MenuItem Key="9">     <Icon Type="@IconType.Outline.User" />پروفایل
                        <span>
                   
                        
                    </span>
                    </MenuItem>
                     <MenuItem Key="10">
                             <Icon Type="@IconType.Outline.Logout" />
