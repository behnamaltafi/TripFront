@page "/friend-requests"
@using AntDesign
@using AntDesign.Filters
@using AntDesign.TableModels
@using FilterPagingEfCore.Extenstion
@using FilterPagingEfCore.Filter
@using FilterPagingEfCore.Paging
@inject IFriendRequestService FriendRequestService
@using FilterPagingEfCore.Sort
@using TripFront.Components.FrontUtility
@rendermode InteractiveServer
<h1>درخواست ها</h1>
<style>
    #components-form-demo-form-context .user {
        margin-bottom: 8px;
    }

        #components-form-demo-form-context .user .ant-avatar {
            margin-right: 8px;
        }

    .ant-row-rtl #components-form-demo-form-context .user .ant-avatar {
        margin-right: 0;
        margin-left: 8px;
    }
</style>
<Button HtmlType="submit" Type="ButtonType.Primary" OnClick="ShowModal">
    Submit
</Button>
<Table TItem="FriendRequestDTO"
       DataSource="@requests"
       Total="@totalCount"
       PageSize="@pageSize"
       PageIndex="@currentPage"
       OnChange="@OnTableChange"
       Loading="@isLoading">
    <PropertyColumn Property="r => r.SenderFamilyTitle" Title="درخواست دهنده" Sortable Filterable />
    <PropertyColumn Property="r => r.Status.GetDisplayName()" Title="وضعیت" Sortable Filterable />
    <PropertyColumn Property="r => r.SentAt.ToShamsi()" Title="ارسال شده در" Sortable Filterable />


    <ActionColumn Title="Action">
        <Space Size="SpaceSize.Middle">
            <SpaceItem>
                <a>Accept </a>
            </SpaceItem>
            <SpaceItem>
                <a>Delete</a>
            </SpaceItem>
        </Space>
    </ActionColumn>
</Table>

@code {
    private List<FriendRequestDTO> requests = new();
    private int totalCount;
    private int pageSize = 10;
    private int currentPage = 1;
    private bool isLoading = false;
    private bool _modelVisible = false;
    private async Task OnTableChange(QueryModel<FriendRequestDTO> queryModel)
    {
        isLoading = true;

        var result = await FriendRequestService.GetFriendRequestsAsync(queryModel.ToPagingParam());
        requests = result.Items;
        currentPage = result.PageNumber;
        totalCount = result.TotalCount;
        isLoading = false;
    }
    private async Task AcceptRequestAsync(int requestId)
    {
        try
        {
            isLoading = true;
            await FriendRequestService.AcceptFriendRequestAsync(requestId);
            await ReloadDataAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeclineRequestAsync(int requestId)
    {
        try
        {
            isLoading = true;
            await FriendRequestService.RejectFriendRequestAsync(requestId);
            await ReloadDataAsync();
        }
        finally
        {
            isLoading = false;
        }
    }
    private void ShowModal()
    {
        _modelVisible = true;
    }

    private void HideUserModal()
    {
        _modelVisible = false;
        _userForm?.Reset();
    }

    private async Task ReloadDataAsync()
    {
        var paging = new PagingParam
        {

        };
        var result = await FriendRequestService.GetFriendRequestsAsync(paging);
        requests = result.Items;
        totalCount = result.TotalCount;
    }


}
