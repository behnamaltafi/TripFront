@page "/friend-requests"
@using AntDesign
@using AntDesign.Filters
@using AntDesign.TableModels
@using FilterPagingEfCore.Extenstion
@using FilterPagingEfCore.Filter
@using FilterPagingEfCore.Paging
@inject IFriendRequestService FriendRequestService
@using FilterPagingEfCore.Sort
@using TripFront.Components.FrontUtility
@rendermode InteractiveServer

<Table TItem="FriendRequestDTO"
       DataSource="@requests"
       Total="@totalCount"
       PageSize="@pageSize"
       PageIndex="@currentPage"
       OnChange="@OnTableChange"
       Loading="@isLoading">
    <PropertyColumn Property="r => r.SenderFamilyTitle" Title="Sender Family Title" Sortable Filterable />
    <PropertyColumn Property="r => r.Status" Title="Status" Sortable Filterable />
    <PropertyColumn Property="r => r.SentAt" Title="Sent At" Sortable Filterable />
    <PropertyColumn Property="r => r.RespondedAt" Title="Responded At" Sortable Filterable />

    <ActionColumn Title="Action">
        <Template Context="r">
            <Space Size="SpaceSize.Middle">
                <SpaceItem>
                    <Popconfirm Title="Are you sure you want to accept this request?"
                        @*         OnConfirm="@(() => AcceptRequestAsync(r.Id))" *@
                                OkText="Yes"
                                CancelText="No">
                        <a>Accept</a>
                    </Popconfirm>
                </SpaceItem>
                <SpaceItem>
                    <Popconfirm Title="Are you sure you want to decline this request?"
                          @*       OnConfirm="@(() => DeclineRequestAsync(r.Id))" *@
                                OkText="Yes"
                                CancelText="No">
                        <a>Decline</a>
                    </Popconfirm>
                </SpaceItem>
            </Space>
        </Template>
    </ActionColumn>
</Table>

@code {
    private List<FriendRequestDTO> requests = new();
    private int totalCount;
    private int pageSize = 10;
    private int currentPage = 1;
    private bool isLoading = false;

    private async Task OnTableChange(QueryModel<FriendRequestDTO> queryModel)
    {
        isLoading = true;

        var result = await FriendRequestService.GetReceivedFriendRequestsAsync(queryModel.ToPagingParam());
        requests = result.Items;
        currentPage = result.PageNumber;
        totalCount = result.TotalCount;
        isLoading = false;
    }
    private async Task AcceptRequestAsync(int requestId)
    {
        try
        {
            isLoading = true;
            await FriendRequestService.AcceptFriendRequestAsync(requestId);
            await ReloadDataAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeclineRequestAsync(int requestId)
    {
        try
        {
            isLoading = true;
            await FriendRequestService.RejectFriendRequestAsync(requestId);
            await ReloadDataAsync();
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task ReloadDataAsync()
    {
        var paging = new PagingParam
        {

        };
        var result = await FriendRequestService.GetReceivedFriendRequestsAsync(paging);
        requests = result.Items;
        totalCount = result.TotalCount;
    }


}
