@using Microsoft.AspNetCore.Components.Web
@using AntDesign

<style>
	:root {
		--primary-color: #1890ff;
		--success-color: #52c41a;
		--danger-color: #f5222d;
		--shadow-color: rgba(0, 0, 0, 0.15);
		--avatar-size: 72px;
		--gap-size: 6px;
	}

	/* کاور و آواتار */
	.cover-with-avatar {
		position: relative;
		height: 180px;
		overflow: visible;
	}

		.cover-with-avatar img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			border-radius: 8px 8px 0 0;
		}

	.cover-avatar {
		position: absolute;
		bottom: calc(var(--avatar-size) / -2); /* نصف آواتار خارج از کاور */
		left: 16px;
		z-index: 10;
		background: white;
		border-radius: 50%;
		padding: 4px;
		box-shadow: 0 0 6px var(--shadow-color);
	}

	/* کارت سفر */
	.trip-card-custom {
		height: 100%;
		display: flex;
		flex-direction: column;
		transition: all 0.3s ease;
		border-radius: 8px;
		overflow: hidden;
		direction: rtl;
	}

		.trip-card-custom:hover {
			box-shadow: 0 4px 12px var(--shadow-color);
			transform: translateY(-3px);
		}

		.trip-card-custom .ant-card-body {
			flex-grow: 1;
			display: flex;
			flex-direction: column;
			padding: 16px;
		}

		.trip-card-custom .ant-card-meta-title {
			font-size: 1.2rem;
			font-weight: 600;
			margin-bottom: 10px;
		}

		.trip-card-custom .trip-info-item {
			margin-bottom: 8px;
			display: flex;
			align-items: baseline;
		}

	.trip-info-label {
		font-weight: 600;
		margin-left: 8px;
		min-width: 90px;
		color: #555;
	}

	.trip-info-value {
		flex: 1;
		color: #333;
	}

	/* خانواده‌ها */
	.family-icons {
		display: flex;
		gap: var(--gap-size);
		align-items: center;
	}

	.family-icon {
		width: 36px;
		height: 36px;
	}

	.family-avatar {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		overflow: hidden;
		background-color: #f0f0f0;
		font-size: 14px;
		font-weight: bold;
		color: #555;
	}

		.family-avatar.fallback {
			background-color: #ccc;
		}

		.family-avatar img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			border-radius: 50%;
			display: block;
		}

	.more-icon .family-avatar {
		background-color: var(--primary-color);
		color: #fff;
		font-weight: bold;
	}

	/* آیکون‌های اکشن */
	.action-icon {
		font-size: 18px;
		cursor: pointer;
		transition: color 0.3s, transform 0.2s;
		padding: 4px;
	}

		.action-icon:hover {
			transform: translateY(-2px);
		}

	.edit-icon:hover {
		color: var(--primary-color);
	}

	.expense-icon:hover {
		color: var(--success-color);
	}

	.delete-icon:hover {
		color: var(--danger-color);
	}

	/* توضیحات */
	.trip-description {
		color: #666;
		max-height: 80px;
		overflow-y: auto;
		margin-top: 8px;
		line-height: 1.6;
	}

	.owner-info {
		margin-top: 10px;
		border-top: 1px dashed #f0f0f0;
		padding-top: 8px;
		color: #777;
	}
</style>
<Card Class="trip-card-custom" Actions="@Actions" Cover="@CoverTemplate" Hoverable="true">
	<div class="trip-card-wrapper" @onclick="HandleCardClick">
		<CardMeta Title="@Trip.Name">
			<DescriptionTemplate>
				<div class="owner-info">
					<Text Type="TextElementType.Secondary">
						<Text Strong>@Trip.OwnerFamilyName</Text>
					</Text>
				</div>
				<div class="trip-details">
					<TripInfoItem Label="تاریخ شروع:" Value="@Trip.StartDate.ToShamsi()" />
					<TripInfoItem Label="تاریخ پایان:" Value="@(Trip.EndDate.HasValue ? Trip.EndDate.Value.ToShamsi() : "-")" />

					@if (!string.IsNullOrWhiteSpace(Trip.Description))
					{
						<TripInfoItem Label="توضیحات:" Value="@Trip.Description" Class="trip-description" />
					}

					<div class="trip-info-item families-preview">
						<div class="family-icons">
							@foreach (var (family, index) in Trip.Families.Select((value, i) => (value, i)))
							{
								if (index < 3)
								{
									<FamilyIcon Family="@family" />
								}
								else if (index == 3)
								{
									<MoreFamiliesIcon Count="@(Trip.Families.Count - 3)" />
									break;
								}
							}
						</div>
					</div>
				</div>
			</DescriptionTemplate>
		</CardMeta>
	</div>
</Card>

@code {
	[Parameter] public TripDTO Trip { get; set; }
	[Parameter] public EventCallback OnEdit { get; set; }
	[Parameter] public EventCallback OnDelete { get; set; }
	[Parameter] public EventCallback OnClick { get; set; }
	[Parameter] public EventCallback OnExpenses { get; set; }

	private RenderFragment CoverTemplate => builder =>
	{
		builder.OpenElement(0, "div");
		builder.AddAttribute(1, "class", "cover-with-avatar");

		builder.OpenElement(2, "img");
		builder.AddAttribute(3, "alt", $"تصویر سفر {Trip.Name}");
		builder.AddAttribute(4, "src", string.IsNullOrWhiteSpace(Trip.TripProfileImage)
			? "/images/default-trip-cover.jpg"
			: Trip.TripProfileImage);
		builder.CloseElement();

		builder.OpenElement(5, "div");
		builder.AddAttribute(6, "class", "cover-avatar");
		builder.AddContent(7, AvatarTemplate);
		builder.CloseElement();

		builder.CloseElement();
	};

	private RenderFragment AvatarTemplate => builder =>
	{
		builder.OpenComponent<Avatar>(0);
		builder.AddAttribute(1, "Style", $"width: var(--avatar-size); height: var(--avatar-size); font-size: calc(var(--avatar-size) / 2);");
		builder.AddAttribute(2, "Shape", AvatarShape.Circle);

		if (!string.IsNullOrWhiteSpace(Trip.OwnerFamilyProfile))
		{
			builder.AddAttribute(3, "Src", Trip.OwnerFamilyProfile);
		}
		else if (!string.IsNullOrWhiteSpace(Trip.OwnerFamilyName))
		{
			var initials = Trip.OwnerFamilyName.Length >= 2
				? Trip.OwnerFamilyName.Substring(0, 2).ToUpper()
				: Trip.OwnerFamilyName.ToUpper();

			builder.AddAttribute(4, "Text", initials);
			builder.AddAttribute(5, "Style", $"background-color: #87d068;");
		}
		else
		{
			builder.AddAttribute(6, "Icon", "user");
		}

		builder.CloseComponent();
	};

	private RenderFragment[] Actions => new RenderFragment[]
	{
		ActionTemplate("edit", "edit-icon", OnEdit),
		ActionTemplate("dollar", "expense-icon", OnExpenses),
		ActionTemplate("delete", "delete-icon", OnDelete)
	};

	private RenderFragment ActionTemplate(string iconType, string cssClass, EventCallback callback) => builder =>
	{
		builder.OpenComponent<Tooltip>(0);
		builder.AddAttribute(2, "ChildContent", (RenderFragment)(childBuilder =>
		{
			childBuilder.OpenComponent<Icon>(3);
			childBuilder.AddAttribute(4, "Type", iconType);
			childBuilder.AddAttribute(5, "Class", $"action-icon {cssClass}");
			childBuilder.AddAttribute(6, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, async (e) => await callback.InvokeAsync()));
			childBuilder.CloseComponent();
		}));
		builder.CloseComponent();
	};

	private async Task HandleCardClick() => await OnClick.InvokeAsync();
}