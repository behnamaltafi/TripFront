@using Microsoft.AspNetCore.Components.Web
@using AntDesign
@using TripFront
<HeadContent>
	<link href="/styles/tripcard.css" rel="stylesheet" />
</HeadContent>

<div class="trip-card-modern" @onclick="HandleCardClick">
	<div class="card-image-container">
		<img src="@Trip.TripProfileImage"
		alt="@Trip.Title"
		class="card-image" />

		<div class="card-overlay">
			<div class="card-actions">
				<Tooltip Title="ویرایش">
					<Button Type="@ButtonType.Text"
					Shape="@ButtonShape.Circle"
					Icon="@IconType.Outline.Edit"
					Class="action-btn edit-btn"
					OnClick="@OnEdit"
					OnClickStopPropagation />
				</Tooltip>

				<Tooltip Title="هزینه‌ها">
					<Button Type="@ButtonType.Text"
					Shape="@ButtonShape.Circle"
					Icon="@IconType.Outline.DollarCircle"
					Class="action-btn expense-btn"
					OnClick="@OnExpenses"
					OnClickStopPropagation />
				</Tooltip>

				<Popconfirm Title="آیا از حذف این سفر اطمینان دارید؟"
				OnConfirm="@OnDelete"
				OkText="بله"
				CancelText="خیر"
				Placement="@Placement.TopRight">
					<Tooltip Title="حذف">
						<Button OnClickStopPropagation Type="@ButtonType.Text"
						Shape="@ButtonShape.Circle"
						Icon="@IconType.Outline.Delete"
						Class="action-btn delete-btn" />
					</Tooltip>
				</Popconfirm>
			</div>
		</div>

		<div class="card-badge">
			<Tag Color="@GetStatusColor()" Class="status-tag">
				@GetTripStatus()
			</Tag>
		</div>

	</div>

	<div class="card-content">
		<div class="card-header">
			<h3 class="card-title">@Trip.Title</h3>
			<div class="card-owner">
				<Icon Type="@IconType.Outline.User" />
				<span> @Trip.OwnerFamilyName</span>
			</div>
		</div>

		@if (!string.IsNullOrWhiteSpace(Trip.Description))
		{
			<p class="card-description">@Trip.Description</p>
		}

		<div class="card-meta">
			<div class="meta-item">
				<Icon Type="@IconType.Outline.Calendar" />
				<span>@Trip.StartDate.ToShamsi()</span>
			</div>

			@if (Trip.EndDate.HasValue)
			{
				<div class="meta-item">
					<Icon Type="@IconType.Outline.ArrowLeft" />
					<span>@Trip.EndDate.Value.ToShamsi()</span>
				</div>
			}

			<div class="meta-item">
				<Icon Type="@IconType.Outline.Calendar" />
				<span>@GetTripDuration() روز</span>
			</div>
		</div>

		@if (Trip.Budget != 0)
		{
			<div class="card-budget">
				<Icon Type="@IconType.Outline.DollarCircle" />
				<span class="budget-amount">@Trip.Budget.ToString("N0")</span>
				<span class="budget-label">تومان</span>
			</div>
		}

		<div class="card-footer">
			<div class="family-avatars">
				@foreach (var (family, index) in Trip.Families.Select((value, i) => (value, i)))
				{
		
					if (index < 4)
					{
						<Avatar Size="AvatarSize.Small"
						Src="@familyImages.GetValueOrDefault(family.Id, "")"
						Text="@GetFamilyInitials(family)"
						Class="family-avatar-item"
						Style="@($"margin-left: {(index > 0 ? -8 : 0)}px; z-index: {4 - index};")" />
					}
				}

				@if (Trip.Families.Count > 4)
				{
					<Avatar Size="AvatarSize.Small"
					Text="@($"+{Trip.Families.Count - 4}")"
					Class="family-avatar-more"
					Style="margin-left: -8px; z-index: 0; background: var(--primary-color); color: white;" />
				}
			</div>

			<div class="trip-progress">
				@{
					var progress = CalculateTripProgress();
				}
				<Progress Percent="@progress"
				ShowInfo="false"
				StrokeColor="@GetProgressColor(progress)"
				Size="@ProgressSize.Small" />
			</div>
		</div>
	</div>
</div>



@code {
	private Dictionary<int, string> familyImages = new();
	[Parameter] public TripDTO Trip { get; set; }
	[Parameter] public EventCallback OnEdit { get; set; }
	[Parameter] public EventCallback OnDelete { get; set; }
	[Parameter] public EventCallback OnClick { get; set; }
	[Parameter] public EventCallback OnExpenses { get; set; }
	[Inject] private IFamilyService _familyService { get; set; }

	

	private string GetOwnerAvatar()
	{
		return !string.IsNullOrWhiteSpace(Trip.OwnerFamilyProfile)
			? Trip.OwnerFamilyProfile
			: null;
	}

	private string GetOwnerInitials()
	{
		if (string.IsNullOrWhiteSpace(Trip.OwnerFamilyName))
			return "?";

		var names = Trip.OwnerFamilyName.Split(' ');
		if (names.Length >= 2)
			return $"{names[0][0]}{names[1][0]}".ToUpper();

		return Trip.OwnerFamilyName.Substring(0, Math.Min(2, Trip.OwnerFamilyName.Length)).ToUpper();
	}

	private string GetFamilyInitials(FamilyDTO family)
	{
		if (string.IsNullOrWhiteSpace(family.Name))
			return "?";

		var names = family.Name.Split(' ');
		if (names.Length >= 2)
			return $"{names[0][0]}{names[1][0]}".ToUpper();

		return family.Name.Substring(0, Math.Min(2, family.Name.Length)).ToUpper();
	}
	private async Task<string> GetFamilyImage(int familyId)
	{
		return await _familyService.GetProfileByFamilyId(familyId);
	}

	private string GetTripStatus()
	{
		var now = DateTime.Now;
		if (Trip.StartDate > now) return "پیش رو";
		if (Trip.EndDate.HasValue && Trip.EndDate.Value < now) return "تکمیل شده";
		return "در حال انجام";
	}

	private string GetStatusColor()
	{
		var now = DateTime.Now;
		if (Trip.StartDate > now) return "blue";
		if (Trip.EndDate.HasValue && Trip.EndDate.Value < now) return "default";
		return "green";
	}

	private int GetTripDuration()
	{
		if (Trip.EndDate.HasValue)
		{
			return (Trip.EndDate.Value - Trip.StartDate).Days + 1;
		}
		return 1;
	}

	private double CalculateTripProgress()
	{
		var now = DateTime.Now;

		if (now < Trip.StartDate)
			return 0;

		if (!Trip.EndDate.HasValue || now > Trip.EndDate.Value)
			return 100;

		var totalDays = (Trip.EndDate.Value - Trip.StartDate).TotalDays;
		var elapsedDays = (now - Trip.StartDate).TotalDays;

		return Math.Round((elapsedDays / totalDays) * 100, 0);
	}

	protected override async Task OnInitializedAsync()
	{

		foreach (var family in Trip.Families.Take(4))
		{
			familyImages[family.Id] = await GetFamilyImage(family.Id);
		}


		
	}
	private string GetProgressColor(double progress)
	{
		if (progress < 30) return "#52c41a";
		if (progress < 70) return "#1890ff";
		return "#e72929";
	}

	private async Task HandleCardClick() => await OnClick.InvokeAsync();
}
