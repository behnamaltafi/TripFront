@page "/1"
@using AntDesign
@using AutoMapper
@using FilterPagingEfCore.Extenstion
@using FilterPagingEfCore.Filter
@using FilterPagingEfCore.Paging
@inject ITripService _tripService
@inject IExpenseService _expenseService
@inject IMapper _mapper
@inject IMessageService Message
@rendermode InteractiveServer

<div class="trips-container">
    <div class="trips-hero">
        <div class="hero-background">
            <div class="hero-overlay"></div>
        </div>
        <div class="hero-content">
            <h1 class="hero-title">سفرهای شما</h1>
            <p class="hero-subtitle">خاطرات زیبای سفر را ثبت کنید و مدیریت کنید</p>
            <Button Type="@ButtonType.Primary"
                    Size="@ButtonSize.Large"
                    Icon="@IconType.Outline.Plus"
                    Disabled="@isLoadingTrips"
                    OnClick="@ShowAddTripModal"
                    Class="hero-cta-btn">
                <span>برنامه‌ریزی سفر جدید</span>
            </Button>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="stats-section">
        <div class="stats-container">
            <div class="stat-item">
                <Icon Type="@IconType.Outline.Compass" Class="stat-icon" />
                <div class="stat-info">
                    <span class="stat-value">@trips.Count</span>
                    <span class="stat-label">سفر ها</span>
                </div>
            </div>
            <div class="stat-item">
                <Icon Type="@IconType.Outline.Calendar" Class="stat-icon" />
                <div class="stat-info">
                    <span class="stat-value">@GetActiveTripCount()</span>
                    <span class="stat-label">بدهکار</span>
                </div>
            </div>
            <div class="stat-item">
                <Icon Type="@IconType.Outline.Team" Class="stat-icon" />
                <div class="stat-info">
                    <span class="stat-value">@GetTotalTravelers()</span>
                    <span class="stat-label">دوستان</span>
                </div>
            </div>
            <div class="stat-item">
                <Icon Type="@IconType.Outline.DollarCircle" Class="stat-icon" />
                <div class="stat-info">
                    <span class="stat-value">@GetTotalBudget()</span>
                    <span class="stat-label">بستانکار</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="filter-section">
        <div class="filter-container">
            <div class="filter-left">
                <Input Placeholder="جستجوی سفر..."
                       Size="@InputSize.Large"
                       Class="search-input"
                       AllowClear="true"
                       @bind-Value="searchTerm"
                       OnPressEnter="@(() => FilterTrips())" />

            </div>

            <div class="filter-right">
                <RadioGroup @bind-Value="viewMode" ButtonStyle="@RadioButtonStyle.Solid">
                    <Radio RadioButton Value="@("grid")">
                        <Icon Type="@IconType.Outline.OrderedList" />
                    </Radio>
                    <Radio RadioButton Value="@("list")">
                        <Icon Type="@IconType.Outline.UnorderedList" />
                    </Radio>
                </RadioGroup>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="trips-content">
        @if (isLoadingTrips)
        {
            <div class="loading-container">
                <Spin Size="@SpinSize.Large">
                    <div class="loading-content">
                        <Icon Type="@IconType.Outline.Loading3Quarters" Spin Class="loading-icon" />
                        <p>در حال بارگذاری سفرها...</p>
                    </div>
                </Spin>
            </div>
        }
        else if (!trips.Any())
        {
            <div class="empty-container">
                <Empty Description="@emptyMessage"
                       Class="custom-empty">
                    <ChildContent>
                        <Button Type="@ButtonType.Primary"
                                Icon="@IconType.Outline.Plus"
                                OnClick="@ShowAddTripModal">
                            اولین سفر خود را ایجاد کنید
                        </Button>
                    </ChildContent>
                </Empty>
            </div>
        }
        else
        {
            @if (viewMode == "grid")
            {
                <div class="trips-grid">
                    @foreach (var trip in filteredTrips)
                    {
                        <div class="trip-card-wrapper">
                            <TripCard Trip="trip"
                                      OnClick="@(() => NavigateToTripDetails(trip.Id))"
                                      OnDelete="() => DeleteTripAsync(trip.Id)"
                                      OnEdit="() => ShowEditTripModal(trip.Id)"
                                      OnExpenses="() => ShowExpensesModalAsync(trip.Id)" />
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="trips-list">
                    @foreach (var trip in filteredTrips)
                    {
                        <div class="trip-list-item">
                            <div class="trip-list-image">
                                <img src="@GetTripImage(trip)" alt="@trip.Title" />
                                <Tag Color="@GetStatusColor(trip)" Class="trip-status-badge">
                                    @GetTripStatus(trip)
                                </Tag>
                            </div>

                            <div class="trip-list-content">
                                <h3>@trip.Title</h3>
                                <p class="trip-description">@trip.Description</p>
                                <div class="trip-meta">
                                    <span><Icon Type="@IconType.Outline.Calendar" /> @trip.StartDate.ToString("yyyy/MM/dd") - @trip.EndDate.Value.ToString("yyyy/MM/dd")</span>
                                    <span><Icon Type="@IconType.Outline.Team" /> @trip.Families?.Count() نفر</span>
                                    <span><Icon Type="@IconType.Outline.DollarCircle" /> 500000 تومان</span>
                                </div>
                            </div>

                            <div class="trip-list-actions">
                                <Button Type="@ButtonType.Link"
                                        Icon="@IconType.Outline.Eye"
                                        OnClick="@(() => NavigateToTripDetails(trip.Id))">
                                    مشاهده
                                </Button>
                                <Button Type="@ButtonType.Link"
                                        Icon="@IconType.Outline.Edit"
                                        OnClick="@(() => ShowEditTripModal(trip.Id))">
                                    ویرایش
                                </Button>
                                <Button Type="@ButtonType.Link"
                                        Icon="@IconType.Outline.DollarCircle"
                                        OnClick="@(() => ShowExpensesModalAsync(trip.Id))">
                                    هزینه‌ها
                                </Button>
                                <Popconfirm Title="آیا از حذف این سفر اطمینان دارید؟"
                                            OnConfirm="@(() => DeleteTripAsync(trip.Id))"
                                            OkText="بله"
                                            CancelText="خیر">
                                    <Button Type="@ButtonType.Link"
                                            Danger
                                            Icon="@IconType.Outline.Delete">
                                        حذف
                                    </Button>
                                </Popconfirm>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- Floating Action Button (Mobile) -->
    <div class="fab-container">
        <Button Type="@ButtonType.Primary"
                Shape="@ButtonShape.Circle"
                Size="@ButtonSize.Large"
                Icon="@IconType.Outline.Plus"
                Class="fab"
                OnClick="@ShowAddTripModal" />
    </div>
</div>

<!-- Trip Form Modal -->
<TripFormModal Title="@tripModalTitle"
               TripModel="@currentTrip"
               Visible="@isTripModalVisible"
               Families="@families"
               OnSave="SaveTripAsync"
               OnCancel="() => isTripModalVisible = false" />

<!-- Expense Modal -->
<Modal Title="هزینه‌های سفر"
       Visible="@isExpenseModalVisible"
       Width="900"
       OnCancel="@(() => { isExpenseModalVisible = false; CancelExpenseEdit(); })"
       Footer="null"
       Class="expense-modal">
    @if (isLoadingExpenses)
    {
        <div class="modal-loading">
            <Spin Tip="در حال بارگذاری هزینه‌ها..." />
        </div>
    }
    else
    {
        <ExpenseTable TripId="@selectedTripId" Families="@families" />
    }
</Modal>



@code {

    [Inject] private IFamilyService _familyService { get; set; }
    private List<TripDTO> trips = new();
    private List<TripDTO> filteredTrips = new();
    private TripDTO currentTrip = new();
    private bool isTripModalVisible = false;
    private string tripModalTitle = string.Empty;
    private int selectedTripId;
    private List<FamilyDTO> families = new();
    private List<ExpenseDTO> expenses = new();
    private ExpenseDTO currentExpense = new();
    private bool isExpenseModalVisible = false;
    private bool isEditingExpense = false;
    private bool isLoadingTrips = false;
    private bool isLoadingExpenses = false;
    private int totalExpensesCount;
    private int expensesPageSize = 10;
    private int expensesCurrentPage = 1;
    private string emptyMessage = "هنوز سفری ثبت نکرده‌اید. اولین سفر خود را برنامه‌ریزی کنید!";

    // New properties for enhanced features
    private string searchTerm = "";
    private string filterStatus = "";
    private string viewMode = "grid";

    [Inject]
    private NavigationManager _navigationManager { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadTripsAsync();
        FilterTrips();
    }

    private async Task LoadTripsAsync()
    {
        try
        {
            isLoadingTrips = true;
            var result = await _tripService.GetTripsForFamilyAsync(PagingParamFactory.CreateDefault());
            trips = result?.Items ?? new();
            FilterTrips();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading trips: {ex.Message}");
            Message.Error("خطا در بارگذاری سفرها");
        }
        finally
        {
            isLoadingTrips = false;
        }
    }

    private void FilterTrips()
    {
        filteredTrips = trips;

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredTrips = filteredTrips.Where(t =>
                t.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                t.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true
            ).ToList();
        }

        // Apply status filter
        if (!string.IsNullOrWhiteSpace(filterStatus))
        {
            var now = DateTime.Now;
            filteredTrips = filterStatus switch
            {
                "upcoming" => filteredTrips.Where(t => t.StartDate > now).ToList(),
                "active" => filteredTrips.Where(t => t.StartDate <= now && t.EndDate >= now).ToList(),
                "completed" => filteredTrips.Where(t => t.EndDate < now).ToList(),
                _ => filteredTrips
            };
        }

        StateHasChanged();
    }

    private int GetActiveTripCount()
    {
        var now = DateTime.Now;
        return trips.Count(t => t.StartDate <= now && t.EndDate >= now);
    }

    private int GetTotalTravelers()
    {
        return trips.Sum(t => t.Families?.Count() ?? 0);
    }

    private string GetTotalBudget()
    {
        var total = 5000000;
        return total.ToString("N0");
    }

    private string GetTripImage(TripDTO trip)
    {
        // You can customize this to return actual trip images
        return $"https://source.unsplash.com/random/400x300?travel,{trip.Title}";
    }

    private string GetTripStatus(TripDTO trip)
    {
        var now = DateTime.Now;
        if (trip.StartDate > now) return "پیش رو";
        if (trip.EndDate < now) return "تکمیل شده";
        return "در حال انجام";
    }

    private string GetStatusColor(TripDTO trip)
    {
        var now = DateTime.Now;
        if (trip.StartDate > now) return "blue";
        if (trip.EndDate < now) return "default";
        return "green";
    }

    private TripDTO CreateNewTrip()
    {
        return new TripDTO
            {
                StartDate = DateTime.Now,
                EndDate = DateTime.Now.AddDays(3)
            };
    }

    private void ShowAddTripModal()
    {
        currentTrip = CreateNewTrip();
        tripModalTitle = "افزودن سفر جدید";
        isTripModalVisible = true;
    }

    private void ShowEditTripModal(int tripId)
    {
        var trip = trips.FirstOrDefault(t => t.Id == tripId);
        if (trip != null)
        {
            currentTrip = trip;
            tripModalTitle = "ویرایش سفر";
            isTripModalVisible = true;
        }
    }

    private async Task SaveTripAsync()
    {
        try
        {
            if (currentTrip.Id == 0)
            {
                await _tripService.CreateTripAsync(_mapper.Map<CreateTripDto>(currentTrip));
                Message.Success("سفر جدید با موفقیت ایجاد شد");
            }
            else
            {
                await _tripService.Update(_mapper.Map<UpdateTripDto>(currentTrip));
                Message.Success("سفر با موفقیت ویرایش شد");
            }

            isTripModalVisible = false;
            await LoadTripsAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error saving trip: {ex.Message}");
            Message.Error("خطا در ذخیره سفر");
        }
    }

    private async Task DeleteTripAsync(int tripId)
    {
        try
        {
            await _tripService.Delete(tripId);
            Message.Success("سفر با موفقیت حذف شد");
            await LoadTripsAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error deleting trip: {ex.Message}");
            Message.Error("خطا در حذف سفر");
        }
    }

    private async Task ShowExpensesModalAsync(int tripId)
    {
        selectedTripId = tripId;
        isExpenseModalVisible = true;
        await LoadFamiliesAsync("");
    }

    private void CancelExpenseEdit()
    {
        isEditingExpense = false;
        currentExpense = new ExpenseDTO();
    }

    private async Task LoadFamiliesAsync(string searchTerm = "")
    {
        try
        {
            var filters = new List<FilterParam>();

            if (searchTerm != "")
            {
                filters.Add(new FilterParam
                    {
                        ColumnName = "Name",
                        FilterValue = searchTerm ?? "",
                        FilterOption = ComparisonMethod.Contain
                    });
            }

            var pagingFilters = new PagingParam { FilterParam = filters };
            var result = await _tripService.GetTripFamilyAsync(pagingFilters, selectedTripId);
            families = _mapper.Map<List<FamilyDTO>>(result.Items);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading families: {ex.Message}");
            Message.Error("خطا در بارگذاری اعضای خانواده");
        }
    }

    private void NavigateToTripDetails(int tripId)
    {
        _navigationManager.NavigateTo($"/trips/{tripId}");
    }
}
