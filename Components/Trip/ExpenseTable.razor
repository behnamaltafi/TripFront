@using AntDesign
@using AntDesign.TableModels
@using AutoMapper
@using FilterPagingEfCore.Extenstion
@using FilterPagingEfCore.Filter
@using FilterPagingEfCore.Paging
@using Microsoft.AspNetCore.Components.Web
@using TripFront.Components.FrontUtility

<Table TItem="ExpenseDTO"
DataSource="@Expenses"
RowKey="e => e.Id"
Bordered="true"
Loading="@IsLoading"
Pagination="true"
Total="@TotalCount"
PageSize="@PageSize"\
OnChange="OnTableChange">

    <TitleTemplate>
        <Flex Justify="FlexJustify.End" Gap="@("10")">
            <Button Type="ButtonType.Primary" Icon="plus" OnClick="ShowAddModal">افزودن هزینه جدید</Button>
        </Flex>
    </TitleTemplate>

    <ColumnDefinitions Context="row">
        <PropertyColumn Property="r => r.FamilyName" Title="نام" Filterable />
        <PropertyColumn Property="r => r.Description" Title="توضیحات" Filterable />
        <PropertyColumn Property="r => r.Amount" Title="هزینه" Sortable Filterable />
        <ActionColumn Title="عملیات">
            <Space Size="SpaceSize.Middle">
                <SpaceItem>
                    <a @onclick="() => Edit(row.Id)">ویرایش</a>
                </SpaceItem>
                <SpaceItem>
                    <a @onclick="() => DeleteAsync(row.Id)">حذف</a>
                </SpaceItem>
            </Space>
        </ActionColumn>
    </ColumnDefinitions>
</Table>

<Modal Title="افزودن هزینه جدید"
Visible="@IsAddModalVisible"
OnOk="Save"
OnCancel="CloseAddModal"
OkText="@OK"
CancelText="@Cancel"
DestroyOnClose="true">

    <Form Model="@Model" Layout="FormLayout.Vertical">
        <FormItem Label="خانواده پرداخت‌کننده">
            <Select DataSource="@Families"
            Value="@SelectedFamilyId"
            ValueChanged="@((int? value) => OnFamilyChanged(value))"
            ItemValue="p => p.Id"
            ItemLabel="p => p.Name"
            EnableSearch="true"
            Placeholder="انتخاب خانواده"
            OnFocus="@Focus"
            OnSearch="async (value) => await Search(value)"
            AutoClearSearchValue="false" />
        </FormItem>

        <FormItem Label="مبلغ" Required>
            <Input Number @bind-Value="Model.Amount" />
        </FormItem>

        <FormItem Label="توضیحات">
            <Input Type="InputType.Text"  @bind-value="Model.Description" Rows="3" />
        </FormItem>
    </Form>
</Modal>
@code {
    [Inject] private IExpenseService _expenseService { get; set; }
    [Inject] private IFriendshipService _friendshipService { get; set; }
    [Inject] private IMapper _mapper { get; set; }

    [Parameter] public int TripId { get; set; }
    [Parameter] public List<FamilyDTO> Families { get; set; } = new();

    private List<ExpenseDTO> Expenses { get; set; } = new();
    private ExpenseDTO Model { get; set; } = new();
    private int? SelectedFamilyId { get; set; }
    private bool IsAddModalVisible { get; set; }

    private string OK => "ثبت";
    private string Cancel => "انصراف";

    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 10;
    private int TotalCount { get; set; }
    private bool IsLoading { get; set; }



    private async Task OnTableChange(QueryModel<ExpenseDTO> queryModel)
    {
        try
        {
            IsLoading = true;

            var result = await _expenseService.FindTripExpenses(queryModel.ToPagingParam(), TripId);
            Expenses = _mapper.Map<List<ExpenseDTO>>(result.Items);
            TotalCount = result.TotalCount;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading expenses: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ShowAddModal()
    {
        Model = new ExpenseDTO();
        SelectedFamilyId = null;
        IsAddModalVisible = true;
    }

    private void Edit(int id)
    {
        var existing = Expenses.FirstOrDefault(e => e.Id == id);
        if (existing is not null)
        {
            Model = new ExpenseDTO
                {
                    Id = existing.Id,
                    FamilyId = existing.FamilyId,
                    Amount = existing.Amount,
                    Description = existing.Description
                };
            SelectedFamilyId = Model.FamilyId;
            IsAddModalVisible = true;
        }
    }

    private async Task Save()
    {
        try
        {
            if (Model.Id == 0)
            {
                var addDto = _mapper.Map<AddExpenseDTO>(Model);
                await _expenseService.Add(addDto);
            }
            else
            {
                var updateDto = _mapper.Map<UpdateExpenseDTO>(Model);
                await _expenseService.Update(updateDto);
            }

            IsAddModalVisible = false;

        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error saving expense: {ex.Message}");
        }
    }

    private async Task DeleteAsync(int expenseId)
    {
        try
        {
            await _expenseService.Remove(expenseId);

        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error deleting expense: {ex.Message}");
        }
    }

    private Task CloseAddModal()
    {
        IsAddModalVisible = false;
        return Task.CompletedTask;
    }

    private void OnFamilyChanged(int? value)
    {
        SelectedFamilyId = value;
        if (value.HasValue)
        {
            Model.FamilyId = value.Value;
        }
    }
    private async Task LoadFamiliesAsync(string searchTerm)
    {
        var filters = new List<FilterParam>
        {
            new FilterParam
            {
                ColumnName = "Name",
                FilterValue = searchTerm ?? "",
                FilterOption = ComparisonMethod.Contain
            }
        };
        var pagingFilters = new PagingParam { FilterParam = filters };
        var result = await _friendshipService.GetFriendsAsync(pagingFilters);
        Families = result.Items;
        StateHasChanged();
    }
    private async Task Focus()
    {
        await LoadFamiliesAsync("");
    }

    private async Task Search(string searchTerm)
    {
        await LoadFamiliesAsync(searchTerm);

    }
}


