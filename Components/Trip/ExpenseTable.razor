@using AntDesign
@using AntDesign.TableModels
@using AutoMapper
@using FilterPagingEfCore.Extenstion
@using FilterPagingEfCore.Filter
@using TripFront.Components.FrontUtility
@using FilterPagingEfCore.Paging
@implements IAsyncDisposable

<div class="expense-container">
    <!-- HEADER -->
    <div class="expense-header">
        <Button Type="@ButtonType.Text"
                Icon="@IconType.Outline.ArrowLeft"
                OnClick="@OnBack"
                Class="back-button">
            <span class="back-text">بازگشت</span>
        </Button>

        <div class="header-content">
            <h2 class="header-title">
                <Icon Type="@IconType.Outline.DollarCircle" Class="header-icon" />
                مجموع هزینه‌ها: @(Expenses?.Sum(e => e.Amount).ToString("N0") ?? "0") تومان
            </h2>
        </div>

        <Button Type="@ButtonType.Primary"
                Size="@ButtonSize.Small"
                Icon="@IconType.Outline.Plus"
                OnClick="@ShowAddForm"
                Class="desktop-add-button">
            <span>هزینه جدید</span>
        </Button>
    </div>

    <!-- CONTENT -->
    <div class="expense-content" @ref="_expenseListDiv">
        @if (ShowForm)
        {
            <!-- فرم افزودن/ویرایش -->
            <Card Class="expense-form-card">
                <h3 class="card-title">@((Model.Id == 0) ? "افزودن هزینه" : "ویرایش هزینه")</h3>

                <Form Model="@Model" >
                    <div class="expense-form">
                        <FormItem Label="خانواده">
                      
                            <Select DataSource="@Families"
                                    Value="@SelectedFamilyId"
                      
                                    ItemValue="p => p.Id"
                                    ItemLabel="p => p.Name"
                                    EnableSearch="true"
                                    Placeholder="انتخاب عضو" />
                     
                        </FormItem> 

                        <FormItem Label="مبلغ (تومان)">
                            <AntDesign.InputNumber  Value= "Model.Amount"
                                                   Min="0"
                                                   Style="width:100%"
                                                   Formatter="value => value.ToString()" />
                        </FormItem> 
 
                        <FormItem Label="توضیحات">
                            <TextArea @bind-Value="Model.Description" Rows="3" ShowCount MaxLength="500" />
                        </FormItem> 

                        <div class="form-actions">
                            <Button OnClick="CancelForm" Type="@ButtonType.Default">انصراف</Button>
                            <Button Loading="@IsSaving" Type="@ButtonType.Primary" HtmlType="submit">ذخیره</Button>
                        </div>
                    </div>
                </Form>
            </Card>
        }

        @if (IsLoading)
        {
            <div class="loading-state">
                <Spin Size="@SpinSize.Large" Tip="در حال بارگذاری..." />
            </div>
        }
        else if (!Expenses.Any())
        {
            <Empty Description="@EmptyMessage" Class="custom-empty">
                <ChildContent>
                    <Button Type="@ButtonType.Primary"
                            Icon="@IconType.Outline.Plus"
                            OnClick="@ShowAddForm">
                        اولین هزینه را ثبت کنید
                    </Button>
                </ChildContent>
            </Empty>
        }
        else
        {
            <!-- نمایش دسکتاپ (جدول) -->
            <div class="desktop-view">
                <Table TItem="ExpenseDTO"
                       DataSource="@Expenses"
                       RowKey="f => f.Id"
                       Bordered="true"
                       Size="@TableSize.Small"
                       Class="expense-table">
                    <ColumnDefinitions>
                        <PropertyColumn Property="r => r.FamilyName" Title="خانواده" Sortable />
                        <PropertyColumn Property="r => r.Amount" Title="مبلغ (تومان)" Sortable>
                            <Template>
                                <span class="amount-cell">@context.Amount.ToString("N0")</span>
                            </Template>
                        </PropertyColumn>
                        <PropertyColumn Property="r => r.Description" Title="توضیحات" Ellipsis />
                        <ActionColumn Title="عملیات" Fixed="ColumnFixPlacement.Right">
                            <Space Size="@SpaceSize.Small">
                                <SpaceItem>
                                    <Button Type="@ButtonType.Link"
                                            Size="@ButtonSize.Small"
                                            Icon="@IconType.Outline.Edit"
                                            OnClick="() => Edit(context.Id)">
                                        ویرایش
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Popconfirm Title="آیا مطمئن هستید؟"
                                                OkText="بله"
                                                CancelText="خیر"
                                                OnConfirm="() => DeleteAsync(context.Id)">
                                        <Button Type="@ButtonType.Link"
                                                Danger
                                                Size="@ButtonSize.Small"
                                                Icon="@IconType.Outline.Delete">
                                            حذف
                                        </Button>
                                    </Popconfirm>
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>
                </Table>

                <div class="expense-pagination desktop-pagination">
                    <Pagination Current="@CurrentPage"
                                PageSize="@PageSize"
                                Total="@TotalCount"
                                OnChange="@OnPageChanged"
                                ShowSizeChanger="true"
                           @*      ShowTotal="total => $\" مجموع {total} هزینه\"" *@
                            
                                Class="pagination-responsive" />
                </div>
            </div>

            <!-- نمایش موبایل (کارت) -->
            <div class="mobile-view">
                <div class="expense-list">
                    @foreach (var expense in Expenses)
                    {
                        <Card Class="expense-card" Hoverable>
                            <div class="expense-item">
                                <div class="expense-info">
                                    <div class="family-name">
                                        <Icon Type="@IconType.Outline.Team" />
                                        @expense.FamilyName
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(expense.Description))
                                    {
                                        <div class="expense-desc">@expense.Description</div>
                                    }
                                </div>
                                <div class="expense-amount">
                                    <div class="amount">@expense.Amount.ToString("N0")</div>
                                    <div class="currency">تومان</div>
                                </div>
                            </div>
                            <Divider Style="margin: 12px 0;" />
                            <div class="expense-actions">
                                <Button Type="@ButtonType.Link"
                                        Size="@ButtonSize.Small"
                                        Icon="@IconType.Outline.Edit"
                                        OnClick="@(() => Edit(expense.Id))">
                                    ویرایش
                                </Button>
                                <Popconfirm Title="حذف شود؟"
                                            OkText="بله"
                                            CancelText="خیر"
                                            OnConfirm="@(() => DeleteAsync(expense.Id))">
                                    <Button Type="@ButtonType.Link"
                                            Danger
                                            Size="@ButtonSize.Small"
                                            Icon="@IconType.Outline.Delete">
                                        حذف
                                    </Button>
                                </Popconfirm>
                            </div>
                        </Card>
                    }
                </div>

                @if (IsLoadingMore)
                {
                    <div class="loading-more">
                        <Spin Size="@SpinSize.Small" />
                        <span>در حال بارگذاری...</span>
                    </div>
                }

                @if (IsAllLoaded && Expenses.Any())
                {
                    <div class="all-loaded">
                        <Icon Type="@IconType.Outline.Check" />
                        تمام هزینه‌ها بارگذاری شدند
                    </div>
                }
            </div>
        }
    </div>

    <!-- دکمه شناور (فقط موبایل) -->
    @if (!ShowForm)
    {
        <div class="fab-container">
            <Button Type="@ButtonType.Primary"
                    Shape="@ButtonShape.Circle"
                    Size="@ButtonSize.Large"
                    Icon="@IconType.Outline.Plus"
                    OnClick="@ShowAddForm"
                    Class="fab-button" />
        </div>
    }
</div>



@code {
    [Inject] private IExpenseService _expenseService { get; set; }
    [Inject] private IMapper _mapper { get; set; }
    [Inject] private IMessageService _message { get; set; }
    [Inject] private IJSRuntime JS { get; set; }

    [Parameter] public int TripId { get; set; }
    [Parameter] public List<FamilyDTO> Families { get; set; } = new();
    [Parameter] public EventCallback OnBack { get; set; }

    private List<ExpenseDTO> Expenses { get; set; } = new();
    private ExpenseDTO Model { get; set; } = new();
    private int? SelectedFamilyId { get; set; }
    private bool ShowForm { get; set; }
    private bool IsSaving { get; set; }
    private bool IsLoading { get; set; }
    private string EmptyMessage => "هنوز هزینه‌ای ثبت نشده است";
    private ElementReference _expenseListDiv;
    private DotNetObjectReference<ExpenseTable> _dotNetRef;

    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 10;
    private int TotalCount { get; set; }
    private bool IsLoadingMore { get; set; }
    private bool IsAllLoaded { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadExpensesAsync(true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {

                await JS.InvokeVoidAsync("expenseScrollHandler.attach", _expenseListDiv, _dotNetRef);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error attaching scroll: {ex.Message}");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_expenseListDiv.Id != null)
            {
                await JS.InvokeVoidAsync("expenseScrollHandler.detach", _expenseListDiv);
            }
        }
        catch { /* Ignore */ }

        _dotNetRef?.Dispose();
    }

    private void ShowAddForm()
    {
        Model = new ExpenseDTO { TripId = TripId };
        SelectedFamilyId = null;
        ShowForm = true;
    }

    private void CancelForm()
    {
        ShowForm = false;
        Model = new();
        SelectedFamilyId = null;
    }

    private void Edit(int id)
    {
        var expense = Expenses.FirstOrDefault(x => x.Id == id);
        if (expense != null)
        {
            Model = new ExpenseDTO
            {
                Id = expense.Id,
                Amount = expense.Amount,
                FamilyId = expense.FamilyId,
                Description = expense.Description,
                TripId = expense.TripId
            };
            SelectedFamilyId = expense.FamilyId;
            ShowForm = true;
        }
    }

    private async Task Save()
    {
        if (!SelectedFamilyId.HasValue)
        {
            await _message.Warning("لطفاً خانواده را انتخاب کنید");
            return;
        }

        if (Model.Amount <= 0)
        {
            await _message.Warning("مبلغ باید بیشتر از صفر باشد");
            return;
        }

        try
        {
            IsSaving = true;
            Model.FamilyId = SelectedFamilyId.Value;
            Model.TripId = TripId;

            if (Model.Id == 0)
            {
                var dto = _mapper.Map<AddExpenseDTO>(Model);
                await _expenseService.Add(dto);
                await _message.Success("✅ هزینه با موفقیت ثبت شد");
            }
            else
            {
                var dto = _mapper.Map<UpdateExpenseDTO>(Model);
                await _expenseService.Update(dto);
                await _message.Success("✅ هزینه با موفقیت ویرایش شد");
            }

            ShowForm = false;
            await LoadExpensesAsync(true);
        }
        catch (Exception ex)
        {
            await _message.Error($"❌ خطا: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task DeleteAsync(int id)
    {
        try
        {
            await _expenseService.Remove(id);
            await _message.Success("✅ هزینه حذف شد");
            await LoadExpensesAsync(true);
        }
        catch (Exception ex)
        {
            await _message.Error($"❌ خطا در حذف: {ex.Message}");
        }
    }

    private async Task LoadExpensesAsync(bool reset)
    {
        try
        {
            if (reset)
            {
                IsLoading = true;
                CurrentPage = 1;
            }
            else
            {
                IsLoadingMore = true;
            }

            StateHasChanged();

            var pagingParam = new PagingParam
            {
                PageNumber = reset ? 1 : CurrentPage,
                PageSize = PageSize
            };

            var result = await _expenseService.FindTripExpenses(pagingParam, TripId);
            var newItems = _mapper.Map<List<ExpenseDTO>>(result.Items);

            if (reset)
            {
                Expenses = newItems;
            }
            else
            {
                // جلوگیری از تکراری شدن
                foreach (var item in newItems)
                {
                    if (!Expenses.Any(e => e.Id == item.Id))
                    {
                        Expenses.Add(item);
                    }
                }
            }

            TotalCount = result.TotalCount;
            IsAllLoaded = Expenses.Count >= TotalCount;
        }
        catch (Exception ex)
        {
            await _message.Error($"❌ خطا در بارگذاری: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            IsLoadingMore = false;
            StateHasChanged();
        }
    }

    private async Task OnPageChanged(PaginationEventArgs args)
    {
        CurrentPage = args.Page;
        PageSize = args.PageSize;
        await LoadExpensesAsync(true);
    }

    [JSInvokable]
    public async Task OnScrolledToEnd()
    {
        if (IsLoading || IsLoadingMore || IsAllLoaded)
            return;

        CurrentPage++;
        await LoadExpensesAsync(false);
    }
}