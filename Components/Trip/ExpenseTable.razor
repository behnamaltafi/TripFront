@using AntDesign
@using AntDesign.TableModels
@using AutoMapper
@using FilterPagingEfCore.Extenstion
@using FilterPagingEfCore.Filter
@using TripFront.Components.FrontUtility
@using FilterPagingEfCore.Paging

<div class="expense-container">
    <!-- Header with Back Button and Add Button -->
    <div class="expense-header">
        <div class="header-content">
            <Button Type="@ButtonType.Text"
                    Icon="@IconType.Outline.ArrowLeft"
                    OnClick="@OnBack"
                    Class="back-button">
                <span class="back-text">بازگشت</span>
            </Button>
            <h2 class="header-title">
                <Icon Type="@IconType.Outline.DollarCircle" Class="header-icon" />
                هزینه‌ها @Expenses.Sum(e => e.Amount)
            </h2>
        </div>

        <Button Type="@ButtonType.Primary"
                Size="@ButtonSize.Small"
                Icon="@IconType.Outline.Plus"
                OnClick="@ShowAddForm"
                Class="desktop-add-button btn btn-primary">
            <span>هزینه جدید</span>
        </Button>
    </div>

    <!-- Main Content Area -->
    <div class="expense-content">
        @if (ShowForm)
        {
            <!-- Inline Form -->
            <Card Class="expense-form-card card card-bordered" Bordered="true">
                <CardMeta>
                    <TitleTemplate>
                        <h3 class="card-title">@(Model.Id == 0 ? "ثبت هزینه جدید" : "ویرایش هزینه")</h3>
                    </TitleTemplate>
                </CardMeta>
                <CardContent>
                    <Form Model="@Model" Class="expense-form">
                        <FormItem Label="خانواده" Required Class="form-group">
                            <Select DataSource="@Families"
                                    @bind-Value="@SelectedFamilyId"
                                    ValueName="@nameof(FamilyDTO.Id)"
                                    LabelName="@nameof(FamilyDTO.Name)"
                                    EnableSearch="true"
                                    Placeholder="انتخاب خانواده"
                                    OnFocus="@Focus"
                                    OnSearch="@(async (value) => await Search(value))"
                                    AutoClearSearchValue="false">
                            </Select>
                        </FormItem>

                        <FormItem Label="مبلغ (تومان)" Required Class="form-group">
                            <AntDesign.InputNumber @bind-Value="@Model.Amount"
                                                   Min="0"
                                                   Formatter="@(value => value.ToString("N0"))"
                                                   Style="width: 100%;" />
                        </FormItem>

                        <FormItem Label="توضیحات" Class="form-group">
                            <TextArea @bind-Value="@Model.Description"
                                      Rows="3"
                                      MaxLength="200"
                                      ShowCount
                                      Placeholder="توضیحات اختیاری..." />
                        </FormItem>
                    </Form>
                </CardContent>
                <CardActions>
                    <div class="form-actions">
                        <Space>
                            <Button OnClick="@CancelForm" Class="btn btn-secondary">انصراف</Button>
                            <Button Type="@ButtonType.Primary"
                                    OnClick="@Save"
                                    Loading="@IsSaving"
                                    Class="btn btn-primary">
                                @(Model.Id == 0 ? "ثبت" : "ذخیره")
                            </Button>
                        </Space>
                    </div>
                </CardActions>
            </Card>
        }

        <!-- Expense List -->
        @if (IsLoading)
        {
            <div class="loading-state">
                <Spin Size="@SpinSize.Large" Tip="در حال بارگذاری..." />
            </div>
        }
        else if (!Expenses.Any())
        {
            <Empty Description="@EmptyMessage"
                   Class="custom-empty">
                <ChildContent>
                    <Button Type="@ButtonType.Primary"
                            Icon="@IconType.Outline.Plus"
                            OnClick="@ShowAddForm"
                            Class="btn btn-primary">
                        اولین هزینه را ثبت کنید
                    </Button>
                </ChildContent>
            </Empty>
        }
        else
        {
            <!-- Desktop Table View -->
            <div class="desktop-view">
                <Table DataSource="@Expenses"
                       Loading="@IsLoading"
                       Bordered="true"
                       Size="@TableSize.Default"
                       Class="expense-table">
                    <PropertyColumn Title="خانواده" Property="c=>c.FamilyName" />
                    <PropertyColumn Title="مبلغ" Property="c=>c.Amount" Format="N0">
                        <TitleTemplate>
                            مبلغ به تومان
                        </TitleTemplate>
                    </PropertyColumn>
                    <PropertyColumn Title="توضیحات" Property="c=>c.Description" />
                    <ActionColumn Title="عملیات">
                        <Space>
                            <Button Type="@ButtonType.Text"
                                    Icon="@IconType.Outline.Edit"
                                    OnClick="@(() => Edit(context.Id))" />
                            <Popconfirm Title="آیا از حذف این هزینه اطمینان دارید؟"
                                        OnConfirm="@(() => DeleteAsync(context.Id))"
                                        OkText="بله، حذف شود"
                                        CancelText="خیر">
                                <Button Type="@ButtonType.Text"
                                        Danger
                                        Icon="@IconType.Outline.Delete" />
                            </Popconfirm>
                        </Space>
                    </ActionColumn>
                </Table>
            </div>

            <!-- Mobile List View -->
            <div class="mobile-view">
                <div class="expense-list">
                    @foreach (var expense in Expenses)
                    {
                        <Card Class="expense-card card" Bordered="false" Size="CardSize.Small">
                            <div class="expense-item">
                                <div class="expense-main">
                                    <div class="expense-info">
                                        <div class="family-name">@expense.FamilyName</div>
                                        @if (!string.IsNullOrEmpty(expense.Description))
                                        {
                                            <div class="expense-desc text-muted">@expense.Description</div>
                                        }
                                    </div>
                                    <div class="expense-amount">
                                        <span class="amount text-primary">@expense.Amount.ToString("N0")</span>
                                        <span class="currency text-muted">تومان</span>
                                    </div>
                                </div>
                                <div class="expense-actions">
                                    <Button Type="@ButtonType.Text"
                                            Icon="@IconType.Outline.Edit"
                                            OnClick="@(() => Edit(expense.Id))"
                                            Size="@ButtonSize.Small" />
                                    <Popconfirm Title="آیا از حذف این هزینه اطمینان دارید؟"
                                                OnConfirm="@(() => DeleteAsync(expense.Id))"
                                                OkText="بله، حذف شود"
                                                CancelText="خیر">
                                        <Button Type="@ButtonType.Text"
                                                Danger
                                                Icon="@IconType.Outline.Delete"
                                                Size="@ButtonSize.Small" />
                                    </Popconfirm>
                                </div>
                            </div>
                        </Card>
                    }
                </div>
            </div>

            <!-- Pagination -->
            @if (TotalCount > PageSize)
            {
                <div class="expense-pagination">
                    <Pagination Current="@CurrentPage"
                                PageSize="@PageSize"
                                Total="@TotalCount"
                                OnChange="@OnPageChanged"
                                ShowSizeChanger="true"
                                Class="pagination-responsive" />
                </div>
            }
        }
    </div>

    <!-- FAB for mobile -->
    @if (!ShowForm)
    {
        <div class="fab-container">
            <Button Type="@ButtonType.Primary"
                    Shape="@ButtonShape.Circle"
                    Size="@ButtonSize.Large"
                    Icon="@IconType.Outline.Plus"
                    OnClick="@ShowAddForm"
                    Class="fab-button" />
        </div>
    }


</div>


<style>
    /* Container Styles */
    .expense-container {
        padding: var(--spacing-lg);
        background: var(--bg-primary);
        min-height: 100vh;
        font-family: var(--font-family);
    }

    /* Header Styles */
    .expense-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-lg);
        background: var(--bg-white);
        padding: var(--spacing-md) var(--spacing-lg);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
    }

    .back-button {
        font-size: var(--font-size-base);
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        padding: var(--spacing-xs) var(--spacing-md);
        color: var(--text-secondary);
        transition: all var(--transition-fast);
    }

    .back-button:hover {
        color: var(--primary-color);
        background: var(--bg-secondary);
    }

    .back-text {
        display: inline;
    }

    .header-title {
        margin: 0;
        font-size: var(--font-size-xl);
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        color: var(--text-primary);
    }

    .header-icon {
        color: var(--primary-color);
    }

    .desktop-add-button {
        display: flex;
    }

    /* Stats Styles */
    .expense-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--spacing-md);
        margin-bottom: var(--spacing-lg);
    }

    .stat-card {
        height: auto;
    }

    .stat-card .ant-card-body {
        padding: var(--spacing-md);
    }

    /* Form Card */
    .expense-form-card {
        margin-bottom: var(--spacing-lg);
    }

    .expense-form-card .card-title {
        font-size: var(--font-size-lg);
        margin-bottom: var(--spacing-md);
    }

    .expense-form {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    .expense-form .ant-form-item {
        margin-bottom: 0;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        padding: var(--spacing-md);
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-lighter);
        margin: 0 calc(-1 * var(--spacing-lg)) calc(-1 * var(--spacing-lg));
        border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    }

    /* Desktop/Mobile Views */
    .desktop-view {
        display: block;
    }

    .mobile-view {
        display: none;
    }

    /* Table Styles */
    .expense-table {
        background: var(--bg-white);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    /* Mobile List Styles */
    .expense-list {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    .expense-card {
        border-radius: var(--radius-lg) !important;
        transition: all var(--transition-base);
    }

    .expense-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
    }

    .expense-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--spacing-md);
    }

    .expense-main {
        flex: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .expense-info {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .family-name {
        font-weight: 600;
        font-size: var(--font-size-base);
        color: var(--text-primary);
    }

    .expense-desc {
        font-size: var(--font-size-sm);
    }

    .expense-amount {
        text-align: right;
    }

    .expense-amount .amount {
        font-size: var(--font-size-lg);
        font-weight: 600;
    }

    .expense-amount .currency {
        font-size: var(--font-size-xs);
        margin-right: var(--spacing-xs);
    }

    .expense-actions {
        display: flex;
        gap: var(--spacing-xs);
        border-left: 1px solid var(--border-lighter);
        padding-left: var(--spacing-sm);
    }

    /* FAB Styles */
    .fab-container {
        position: fixed;
        bottom: var(--spacing-lg);
        right: var(--spacing-lg);
        z-index: var(--z-fixed);
        display: none;
    }

    .fab-button {
        width: 56px !important;
        height: 56px !important;
        background: var(--primary-gradient) !important;
        border: none !important;
        box-shadow: var(--shadow-colored);
        transition: all var(--transition-base);
    }

    .fab-button:hover {
        transform: scale(1.1);
        box-shadow: var(--shadow-xl);
    }

    /* Pagination */
    .expense-pagination {
        margin-top: var(--spacing-lg);
        display: flex;
        justify-content: center;
        background: var(--bg-white);
        padding: var(--spacing-md);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
    }

    /* Loading State */
    .loading-state {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 300px;
        background: var(--bg-white);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
    }

    /* Empty State */
    .custom-empty {
        background: var(--bg-white);
        padding: var(--spacing-xxl);
        border-radius: var(--radius-lg);
        text-align: center;
        box-shadow: var(--shadow-sm);
    }

    /* Responsive Media Queries */
    @@media (max-width: 768px) {
        .expense-container {
            padding: 0;
            padding-bottom: 80px;
        }

        .expense-header {
            position: sticky;
            top: 0;
            z-index: var(--z-sticky);
            border-radius: 0;
            margin-bottom: var(--spacing-md);
            padding: var(--spacing-md) var(--spacing-md);
        }

        .back-text {
            display: none;
        }

        .back-button {
            padding: var(--spacing-xs);
        }

        .header-title {
            font-size: var(--font-size-lg);
        }

        .desktop-add-button {
            display: none;
        }

        .expense-stats {
            padding: 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }

        .expense-form-card {
            margin: var(--spacing-md);
            border-radius: var(--radius-lg);
        }

        .expense-form {
            gap: var(--spacing-md);
        }

        .expense-form .ant-form-item-label {
            padding-bottom: var(--spacing-xs);
        }

        .expense-form .ant-input,
        .expense-form .ant-input-number,
        .expense-form .ant-select-selector,
        .expense-form .ant-input-affix-wrapper,
        .expense-form textarea {
            font-size: var(--font-size-base) !important;
        }

        .desktop-view {
            display: none;
        }

        .mobile-view {
            display: block;
            padding: 0 var(--spacing-md);
        }

        .fab-container {
            display: block;
            bottom: var(--spacing-md);
            right: var(--spacing-md);
        }

        .expense-pagination {
            position: sticky;
            bottom: 0;
            margin: 0;
            border-radius: 0;
            box-shadow: 0 -2px 8px rgba(0,0,0,0.1);
        }

        .pagination-responsive .ant-pagination-options {
            display: none;
        }

        .pagination-responsive .ant-pagination-item {
            min-width: 28px;
            height: 28px;
            line-height: 26px;
            margin: 0 2px;
        }
    }

    @@media (max-width: 480px) {
        .expense-stats {
            grid-template-columns: 1fr;
        }

        .expense-amount .amount {
            font-size: var(--font-size-base);
        }

        .family-name {
            font-size: var(--font-size-sm);
        }
    }
</style>

@code {
    [Inject] private IExpenseService _expenseService { get; set; }
    [Inject] private ITripService _tripService { get; set; }
    [Inject] private IMapper _mapper { get; set; }
    [Inject] private IMessageService _message { get; set; }
    [Inject] private NavigationManager NavigationManager { get; set; }

    // Parameters
    [Parameter] public int TripId { get; set; }
    [Parameter] public List<FamilyDTO> Families { get; set; } = new();
    [Parameter] public EventCallback OnBack { get; set; }

    // State
    private List<ExpenseDTO> Expenses { get; set; } = new();
    private ExpenseDTO Model { get; set; } = new();
    private int? SelectedFamilyId { get; set; }
    private bool ShowForm { get; set; }
    private bool IsSaving { get; set; }
    private bool IsLoading { get; set; }
    private string EmptyMessage { get; set; } = "هنوز هزینه‌ای ثبت نشده است";

    // Pagination
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 10;
    private int TotalCount { get; set; }
    private QueryModel<ExpenseDTO> _lastQueryModel = new QueryModel<ExpenseDTO>(1, 10, 1, null, null);

    protected override async Task OnInitializedAsync()
    {
        await RefreshTableAsync();
    }

    private void ShowAddForm()
    {
        Model = new ExpenseDTO();
        SelectedFamilyId = null;
        ShowForm = true;
    }

    private void Edit(int id)
    {
        var existing = Expenses.FirstOrDefault(e => e.Id == id);
        if (existing is not null)
        {
            Model = new ExpenseDTO
            {
                Id = existing.Id,
                FamilyId = existing.FamilyId,
                Amount = existing.Amount,
                Description = existing.Description
            };
            SelectedFamilyId = Model.FamilyId;
            ShowForm = true;
        }
    }

    private void CancelForm()
    {
        ShowForm = false;
        Model = new ExpenseDTO();
        SelectedFamilyId = null;
    }

    private async Task Save()
    {
        try
        {
            IsSaving = true;

            if (!SelectedFamilyId.HasValue)
            {
                await _message.Warning("لطفا خانواده را انتخاب کنید");
                return;
            }

            Model.FamilyId = SelectedFamilyId.Value;

            if (Model.Id == 0)
            {
                var addDto = _mapper.Map<AddExpenseDTO>(Model);
                addDto.TripId = TripId;
                await _expenseService.Add(addDto);
                await _message.Success("هزینه با موفقیت ثبت شد");
            }
            else
            {
                var updateDto = _mapper.Map<UpdateExpenseDTO>(Model);
                await _expenseService.Update(updateDto);
                await _message.Success("هزینه با موفقیت ویرایش شد");
            }

            ShowForm = false;
            await RefreshTableAsync();
        }
        catch (Exception ex)
        {
            await _message.Error($"خطا در ذخیره: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task DeleteAsync(int expenseId)
    {
        try
        {
            await _expenseService.Remove(expenseId);
            await _message.Success("هزینه حذف شد");
            await RefreshTableAsync();
        }
        catch (Exception ex)
        {
            await _message.Error($"خطا در حذف: {ex.Message}");
        }
    }

    private async Task RefreshTableAsync()
    {
        await LoadExpensesAsync(_lastQueryModel ?? new QueryModel<ExpenseDTO>(1, PageSize, 1, null, null));
    }

    private async Task LoadExpensesAsync(QueryModel<ExpenseDTO> queryModel)
    {
        try
        {
            IsLoading = true;
            StateHasChanged();

            var result = await _expenseService.FindTripExpenses(queryModel.ToPagingParam(), TripId);
            Expenses = _mapper.Map<List<ExpenseDTO>>(result.Items);
            TotalCount = result.TotalCount;
            _lastQueryModel = queryModel;
        }
        catch (Exception ex)
        {
            await _message.Error($"خطا در بارگذاری: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnPageChanged(PaginationEventArgs args)
    {
        CurrentPage = args.Page;
        PageSize = args.PageSize;
        await LoadExpensesAsync(new QueryModel<ExpenseDTO>(CurrentPage, PageSize, TotalCount, null, null));
    }

    private async Task LoadFamiliesAsync(string searchTerm)
    {
        var filters = new List<FilterParam>();

        if (!string.IsNullOrEmpty(searchTerm))
        {
            filters.Add(new FilterParam
            {
                ColumnName = "FamilyName",
                FilterValue = searchTerm,
                FilterOption = ComparisonMethod.Contain
            });
        }

        var pagingFilters = new PagingParam { FilterParam = filters };
        var result = await _tripService.GetTripFamilyAsync(pagingFilters, TripId);
        Families = _mapper.Map<List<FamilyDTO>>(result.Items);
        StateHasChanged();
    }

    private async Task Focus()
    {
        await LoadFamiliesAsync("");
    }

    private async Task Search(string searchTerm)
    {
        await LoadFamiliesAsync(searchTerm);
    }
}
