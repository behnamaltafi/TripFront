@using AntDesign
@using AutoMapper

<div class="trip-form-container @(IsMobile ? "mobile" : "desktop")">
    <Card Class="trip-form-card" Bordered="true">
        <CardMeta>
            <TitleTemplate>
                <h3 class="form-title">
                    @Title
                </h3>
            </TitleTemplate>
        </CardMeta>
        <CardContent>
            <Form Model="@TripModel" Layout="@(IsMobile ? FormLayout.Vertical : FormLayout.Vertical)">
                <FormItem Label="نام سفر" Required>
                    <Input @bind-Value="@TripModel.Title" 
                           Size="@(IsMobile ? InputSize.Large : InputSize.Default)"
                           Placeholder="عنوان سفر را وارد کنید" />
                </FormItem>
                
                <Row Gutter="16">
                    <Col Span="@(IsMobile ? 24 : 12)">
                        <FormItem Label="تاریخ شروع" Required>
                            <DatePicker @bind-Value="@TripModel.StartDate" 
                                       Size="@(IsMobile ? InputSize.Large : InputSize.Default)"
                                       Style="width: 100%;"
                                      />
                        </FormItem>
                    </Col>
                    <Col Span="@(IsMobile ? 24 : 12)">
                        <FormItem Label="تاریخ پایان" Required>
                            <DatePicker @bind-Value="@TripModel.EndDate" 
                                       Size="@(IsMobile ? InputSize.Large : InputSize.Default)"
                                       Style="width: 100%;"
                                      />
                        </FormItem>
                    </Col>
                </Row>
                
                <FormItem Label="توضیحات">
                    <TextArea @bind-Value="@TripModel.Description" 
                             Rows="@(IsMobile ? (uint)3 : 4)"
                             Size="@(IsMobile ? InputSize.Large : InputSize.Default)"
                             MaxLength="500"
                             ShowCount
                             Placeholder="توضیحات اختیاری..." />
                </FormItem>
                
                <FormItem>
                    <Button Type="@ButtonType.Dashed" 
                            Icon="@IconType.Outline.Team"
                            Size="@(IsMobile ? ButtonSize.Large : ButtonSize.Default)"
                            OnClick="ShowFamilyModal"
                            Block="@IsMobile">
                        مدیریت خانواده‌ها
                    </Button>
                </FormItem>
            </Form>
        </CardContent>
        <CardActions>
            <div class="form-actions">
                <Space>
                    <Button OnClick="@(() => OnCancel.InvokeAsync())"
                            Size="@(IsMobile ? ButtonSize.Large : ButtonSize.Default)">
                        انصراف
                    </Button>
                    <Button Type="@ButtonType.Primary" 
                            OnClick="OnSave"
                            Loading="@IsSaving"
                            Size="@(IsMobile ? ButtonSize.Large : ButtonSize.Default)">
                        @SaveButtonText
                    </Button>
                </Space>
            </div>
        </CardActions>
    </Card>
    
    <!-- Family Management as Drawer/Modal based on device -->
    @if (IsMobile)
    {
        <Drawer Title="@DrawerTitle"
                Placement="DrawerPlacement.Bottom"
                Height="80%"
                Visible="@ShowFamilyManager"
                OnClose="() => ShowFamilyManager = false">
            <AddFamilyToTripModal TripId="@TripModel.Id"
                                  Visible="true"
                                  VisibleChanged="v => ShowFamilyManager = v" />
        </Drawer>
    }
    else
    {
        <AddFamilyToTripModal TripId="@TripModel.Id"
                              Visible="@ShowFamilyManager"
                              VisibleChanged="v => ShowFamilyManager = v" />
    }
</div>

<style>
    .trip-form-container {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
    }
    
    .trip-form-container.mobile {
        max-width: 100%;
        padding: 0;
    }
    
    .trip-form-card {
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border-radius: 8px;
        overflow: hidden;
    }
    
    .mobile .trip-form-card {
        border-radius: 0;
        box-shadow: none;
        border: none;
    }
    
    .form-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        font-size: 18px;
    }
    
    .form-title .anticon {
        color: #1890ff;
    }
    
    .form-actions {
        display: flex;
        justify-content: flex-end;
        padding: 16px;
        background: #fafafa;
        border-top: 1px solid #f0f0f0;
    }
    
    .mobile .form-actions {
        position: sticky;
        bottom: 0;
        background: white;
        box-shadow: 0 -2px 8px rgba(0,0,0,0.1);
        z-index: 10;
    }
    
    /* Mobile optimizations */
    .mobile .ant-form-item {
        margin-bottom: 16px;
    }
    
    .mobile .ant-input,
    .mobile .ant-picker,
    .mobile .ant-input-affix-wrapper {
        font-size: 16px !important;
    }
    
    .mobile .ant-card-body {
        padding: 16px;
    }
</style>

@code {
    [Inject] private IMapper _mapper { get; set; }
    [Inject] private NavigationManager NavigationManager { get; set; }
    [Inject] private IJSRuntime JSRuntime { get; set; }
    
    [Parameter] public string Title { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public TripDTO TripModel { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public List<FamilyDTO> Families { get; set; } = new();
    
    private List<int> SelectedFamiliesId { get; set; }
    private bool ShowFamilyManager { get; set; }
    private bool IsSaving { get; set; }
    private bool IsMobile { get; set; }
    
    private string SaveButtonText => TripModel?.Id > 0 ? "ذخیره تغییرات" : "ایجاد سفر";
    private string DrawerTitle = "مدیریت خانواده‌ها";
    
    protected override async Task OnInitializedAsync()
    {
        // IsMobile = await JSRuntime.InvokeAsync<bool>("eval", 
        //     "window.innerWidth <= 768 || /iPhone|iPad|iPod|Android/i.test(navigator.userAgent)");
    }

    private void ShowFamilyModal()
    {
        ShowFamilyManager = true;
    }
}