



<div class="family-icon" title="@Family">
	@if (!string.IsNullOrEmpty(ProfileImage))
	{
		<img src="@ProfileImage" alt="@Family" class="family-avatar" />
	}
	else
	{
		<span class="family-avatar fallback">@Family.Substring(0, 1)</span>
	}
</div>

@code {
	[Parameter] public string Family { get; set; }
	[Parameter] public string ProfileImage { get; set; }

}