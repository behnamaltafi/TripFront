@using AntDesign
@implements IAsyncDisposable

<div class="chart-container">
    <!-- Chart Header -->
    <div class="chart-header">
        <div class="chart-title-section">
            <h3 class="chart-title">
                <Icon Type="@IconType.Outline.BarChart" Class="chart-icon" />
                نمودار تسویه حساب
            </h3>
            <p class="chart-subtitle">وضعیت بدهی و طلب خانواده‌ها</p>
        </div>
        <div class="chart-actions">
            <Button Type="@ButtonType.Text"
                    Icon="@IconType.Outline.Reload"
                    OnClick="@RefreshChart"
                    Class="refresh-btn">
                بروزرسانی
            </Button>
        </div>
    </div>

    <!-- Chart Stats -->
    <div class="chart-stats">
        <div class="chart-stat-item positive">
            <Icon Type="@IconType.Outline.ArrowUp" Class="stat-arrow" />
            <div class="stat-info">
                <span class="stat-label">مجموع طلب</span>
                <span class="stat-value">@TotalCredit.ToString("N0") تومان</span>
            </div>
        </div>
        <div class="chart-stat-item negative">
            <Icon Type="@IconType.Outline.ArrowDown" Class="stat-arrow" />
            <div class="stat-info">
                <span class="stat-label">مجموع بدهی</span>
                <span class="stat-value">@TotalDebt.ToString("N0") تومان</span>
            </div>
        </div>
    </div>

    <!-- Chart Canvas -->
    <div class="chart-wrapper">
        @if (IsLoading)
        {
            <div class="chart-loading">
                <Spin Size="@SpinSize.Large">
                    <div class="loading-content">
                        <Icon Type="@IconType.Outline.Loading3Quarters" Spin />
                        <p>در حال بارگذاری نمودار...</p>
                    </div>
                </Spin>
            </div>
        }
        else
        {
            <div class="chart-canvas-wrapper">
                <canvas id="debtChart" class="debt-chart"></canvas>
            </div>
        }
    </div>

    <!-- Chart Legend -->
    <div class="chart-legend">
        <div class="legend-item">
            <span class="legend-color positive"></span>
            <span class="legend-label">طلبکار</span>
        </div>
        <div class="legend-item">
            <span class="legend-color negative"></span>
            <span class="legend-label">بدهکار</span>
        </div>
    </div>

    <!-- Family Details -->
    @if (FamilyDebts.Any())
    {
        <div class="family-details">
            <h4 class="details-title">جزئیات خانواده‌ها</h4>
            <div class="family-cards">
                @foreach (var family in FamilyDebts.OrderByDescending(f => Math.Abs(f.Amount)))
                {
                    <div class="family-card @(family.Amount >= 0 ? "creditor" : "debtor")">
                        <div class="family-header">
                            <div class="family-info">
                                <div class="family-avatar">
                                    <Icon Type="@(family.Amount >= 0 ? IconType.Outline.Plus : IconType.Outline.Minus)" />
                                </div>
                                <span class="family-name">@family.ToFamilyName</span>
                            </div>
                            <div class="family-balance">
                                <span class="balance-amount">@Math.Abs(family.Amount).ToString("N0")</span>
                                <span class="balance-label">@(family.Amount >= 0 ? "طلبکار" : "بدهکار")</span>
                            </div>
                        </div>

                        @if (family.Amount < 0)
                        {
                            <div class="family-actions">
                                <Upload Accept="image/*"
                                        ShowUploadList="false"
                                       >
                                    <Button Type="@ButtonType.Default"
                                            Icon="@IconType.Outline.Upload"
                                            Size="@ButtonSize.Small"
                                            Class="upload-btn">
                                        آپلود رسید
                                    </Button>
                                </Upload>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>



@code {
    [Parameter] public int TripId { get; set; }
    [Parameter] public List<DebtRecordDto> FamilyDebts { get; set; } = new();

    private bool IsLoading { get; set; }
    private decimal TotalCredit => FamilyDebts.Where(f => f.Amount >= 0).Sum(f => f.Amount);
    private decimal TotalDebt => FamilyDebts.Where(f => f.Amount < 0).Sum(f => Math.Abs(f.Amount));

    private IJSObjectReference? _chartModule;
    private bool _chartDrawn = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // _chartModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chart.js");
        }

        if (!_chartDrawn && FamilyDebts.Any() && _chartModule != null)
        {
            await DrawChart();
            _chartDrawn = true;
        }
    }

    private async Task DrawChart()
    {
        var labels = FamilyDebts.Select(f => f.ToFamilyName).ToArray();
        var data = FamilyDebts.Select(f => f.Amount).ToArray();
        var colors = FamilyDebts.Select(f => f.Amount >= 0 ? "#52c41a" : "#ff4d4f").ToArray();

        await _chartModule.InvokeVoidAsync("drawDebtChart", "debtChart", labels, data, colors);
    }

    private async Task RefreshChart()
    {
        IsLoading = true;
        await LoadData();
        _chartDrawn = false;
        IsLoading = false;
    }

    private async Task LoadData()
    {
        // Load your data here
        await Task.CompletedTask;
    }

    private async Task UploadReceipt(UploadInfo args, int familyId)
    {
        // Implement receipt upload logic
        await Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_chartModule != null)
        {
            await _chartModule.InvokeVoidAsync("destroyChart", "debtChart");
            await _chartModule.DisposeAsync();
        }
    }
}
