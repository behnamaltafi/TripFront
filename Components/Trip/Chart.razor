@page "/trips/{TripId:int}"
@using AntDesign
@using AntDesign.TableModels
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<style>
    .chart-container {
        position: relative;
        height: 400px;
        width: 100%;
    }

    .receipt-image {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .upload-btn {
        color: #1890ff;
        cursor: pointer;
        transition: color 0.3s;
    }

        .upload-btn:hover {
            color: #40a9ff;
            text-decoration: underline;
        }
</style>

<PageTitle>تسویه حساب سفر</PageTitle>

<Row Gutter="16" Justify="RowJustify.Center">
    <Col Xs="24" Lg="12">
    <Card Title="جدول شرح بدهی‌ها" Bordered="true">
        <Table TItem="DebtRecordDto"
               DataSource="@Debts"
               RowKey="d => d.Id"
               Bordered="true"
               Size="TableSize.Middle">
            <ColumnDefinitions Context="row">
                <PropertyColumn Property="d => d.FromFamilyName" Title="خانواده بدهکار" />
                <PropertyColumn Property="d => d.ToFamilyName" Title="خانواده بستانکار" />
                <PropertyColumn Property="d => d.ParticipantCount" Title="نفرات" />
                <PropertyColumn Property="d => d.AmountWithToman" Title="مبلغ (تومان)">
                    <Template>
                        <Tag Color="TagColor.Blue">@row.AmountWithToman.ToString()</Tag>
                    </Template>
                </PropertyColumn>
                <PropertyColumn Property="d => d.AccountNumber" Title="شماره کارت">
                    <Template>
                        <Text Code>@row.AccountNumber</Text>
                    </Template>
                </PropertyColumn>
                <ActionColumn Title="عملیات">
                    <Space Size="SpaceSize.Middle">
                            @if (row.IsPaid)
                            {
                            <SpaceItem>
                                <Button Type="@ButtonType.Link"
                                        Icon="@IconType.Outline.Eye"
                                        Size=" ButtonSize.Small"
                                        OnClick="() => ShowReceiptAsync(row.Id)">
                                    نمایش فیش
                                </Button>
                            </SpaceItem>
                            }
                            else
                            {
                            <SpaceItem>
                                <label class="upload-btn">
                                    <Icon Type="@IconType.Outline.Upload" />
                                    آپلود فیش
                                    <InputFile OnChange="e => UploadReceiptAsync(e, row.Id)"
                                               style="display: none;"
                                               accept="image/*" />
                                </label>
                            </SpaceItem>
                            }
                    </Space>
                </ActionColumn>
            </ColumnDefinitions>
        </Table>
    </Card>
    </Col>

    <Col Xs="24" Lg="12">
    <Card Title="نمودار پرداختی‌ها و سهم هر خانواده" Bordered="true">
            @if (_isLoading)
            {
            <div style="text-align: center; padding: 50px;">
                <Spin Size="SpinSize.Large" />
            </div>
            }
            else
            {
            <div class="chart-container">
                <canvas id="settlementChart"></canvas>
            </div>
            }
    </Card>
    </Col>
</Row>

<Modal @bind-Visible="@IsReceiptModalVisible"
       Title="تصویر فیش پرداخت"
       Width="800"
       Footer="null">
    <img src="@ReceiptImageSrc" class="receipt-image" alt="فیش پرداخت" />
</Modal>

@code {
    [Parameter] public int TripId { get; set; }
    [Inject] private IDebtRecordService _debtRecordService { get; set; }
    [Inject] private ISettlementService _settlementService { get; set; }
    [Inject] private IMessageService _message { get; set; }

    private List<DebtRecordDto> Debts = new();
    private string ReceiptImageSrc = "";
    private bool IsReceiptModalVisible = false;
    private SettlementReportDto? _settlementReport;
    private bool _isLoading = true;
    private bool _chartDrawn = false;
    private IJSObjectReference? _chartModule;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Import JavaScript module
            _chartModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/chartHelper.js");
        }

        // Draw chart if data is available and chart hasn't been drawn yet
        if (!_chartDrawn && _settlementReport != null && !_isLoading)
        {
            await DrawChart();
            _chartDrawn = true;
        }
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            _chartDrawn = false;

            _settlementReport = await _settlementService.GetTripSettlementAsync(TripId);

            if (_settlementReport is not null)
            {
                Debts = _settlementReport.OptimizedDebts;
            }
        }
        catch (Exception ex)
        {
            await _message.Error($"خطا در بارگذاری داده‌ها: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged(); // Force re-render
        }
    }

    private async Task DrawChart()
    {
        if (_settlementReport?.Families == null || !_settlementReport.Families.Any())
            return;

        try
        {
            var labels = _settlementReport.Families.Select(f => f.FamilyName).ToArray();
            var paidData = _settlementReport.Families.Select(f => (double)f.TotalPaid).ToArray();
            var shareData = _settlementReport.Families.Select(f => (double)f.TotalShare).ToArray();

            var chartData = new
            {
                labels = labels,
                datasets = new[]
                {
                    new
                    {
                        label = "پرداختی",
                        data = paidData,
                        backgroundColor = "rgba(54, 162, 235, 0.8)",
                        borderColor = "rgba(54, 162, 235, 1)",
                        borderWidth = 1
                    },
                    new
                    {
                        label = "سهم",
                        data = shareData,
                        backgroundColor = "rgba(255, 99, 132, 0.8)",
                        borderColor = "rgba(255, 99, 132, 1)",
                        borderWidth = 1
                    }
                }
            };

            var options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                plugins = new
                {
                    title = new
                    {
                        display = true,
                        text = _settlementReport.TripName,
                        font = new { size = 16 }
                    },
                    legend = new
                    {
                        position = "top"
                    }
                },
                scales = new
                {
                    y = new
                    {
                        beginAtZero = true,
                        ticks = new
                        {
                            // Format numbers with Persian locale
                            callback = "@@function(value) { return value.toLocaleString('fa-IR') + ' تومان'; }"
                        }
                    }
                }
            };

            if (_chartModule != null)
            {
                await _chartModule.InvokeVoidAsync("createBarChart", "settlementChart", chartData, options);
            }
            else
            {
                // Fallback to global method
                await JSRuntime.InvokeVoidAsync("chartHelper.createBarChart", "settlementChart", chartData, options);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error drawing chart: {ex.Message}");
        }
    }

    private async Task ShowReceiptAsync(int debtId)
    {
        try
        {
            var result = await _debtRecordService.GetPaymentReceipt(debtId);
            if (!string.IsNullOrWhiteSpace(result))
            {
                ReceiptImageSrc = $"data:image/jpeg;base64,{result}";
                IsReceiptModalVisible = true;
            }
            else
            {
                await _message.Warning("فیش پرداختی یافت نشد");
            }
        }
        catch (Exception ex)
        {
            await _message.Error($"خطا در نمایش فیش: {ex.Message}");
        }
    }

    private async Task UploadReceiptAsync(InputFileChangeEventArgs e, int debtId)
    {
        try
        {
            var file = e.File;

            // Check file size (max 5MB)
            if (file.Size > 5 * 1024 * 1024)
            {
                await _message.Warning("حجم فایل نباید بیشتر از 5 مگابایت باشد");
                return;
            }

            using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());

            await _debtRecordService.UpdatePaymentReceipt(debtId, base64);
            await _message.Success("فیش پرداخت با موفقیت آپلود شد");

            // Reload data and redraw chart
            _chartDrawn = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            await _message.Error($"خطا در آپلود فیش: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_chartModule != null)
        {
            await _chartModule.InvokeVoidAsync("destroyChart", "settlementChart");
            await _chartModule.DisposeAsync();
        }
    }
}