@page "/trip-report/{TripId:int}"
@using AntDesign
@using AntDesign.TableModels

<AntContainer>
    <Row Gutter="16" Justify="RowJustify.Center">
        <Col Span="10">
            <Card Title="جدول شرح بدهی‌ها" Bordered="true">
                <Table TItem="DebtRecordDto"
                DataSource="@Debts"
                RowKey="d => d.Id"
                Bordered="true">
                    <ColumnDefinitions Context="row">
                    <PropertyColumn Property=" d => d.FromFamilyName" Title="خانواده بدهکار" />
                    <PropertyColumn Property="d => d.ToFamilyName" Title="خانواده بستانکار" />
                    <PropertyColumn Property="d => d.ParticipantCount" Title="نفرات" />
                    <PropertyColumn Property="d => d.AmountWithToman" Title="مبلغ (تومان)" />
                    <PropertyColumn Property="d => d.AccountNumber" Title="شماره کارت" />
                    <PropertyColumn Title="توضیحات" Property="@(d => $"{d.FromFamilyName} باید به {d.ToFamilyName} {d.AmountWithToman} تومان پرداخت کند.")" />


                <ActionColumn Title="عملیات">
                
                        <Space Size="SpaceSize.Middle">
                                @if (row.IsPaid)
                                {
                                <SpaceItem>
                                    <a @onclick="() => ShowReceiptAsync(row.Id)">نمایش فیش</a>
                                </SpaceItem>
                                }
                                else
                                {
                                <SpaceItem>
                                    <label style="cursor: pointer;">
                                        <span>آپلود فیش</span>
                                        <InputFile OnChange="e => UploadReceiptAsync(e, row.Id)" style="display: none;" />
                                    </label>
                                </SpaceItem>
                                }
                        </Space>
      
                    </ActionColumn>
                </ColumnDefinitions>

            </Table>




        </Card>
        </Col>

        <Col Span="12">
        <Card Title="نمودار پرداختی‌ها و سهم هر خانواده">
                @*  @if (ChartData != null)
                {
                    <ColumnChart @ref="ChartRef" Title="@ChartTitle" Data="@ChartData" XField="FamilyName" YField="Amount" SeriesField="Category" Height="400" />
                } *@
        </Card>
        </Col>
    </Row>
</AntContainer>

<Modal @bind-Visible="@IsReceiptModalVisible" Title="تصویر فیش پرداخت" Width="800">
    <img src="@ReceiptImageSrc" class="img-fluid rounded shadow" />
</Modal>

@code {
    [Parameter] public int TripId { get; set; }
    [Inject] private IDebtRecordService _debtRecordService { get; set; }
    [Inject] private ISettlementService _settlementService { get; set; }

    private List<DebtRecordDto> Debts = new();
    private List<ChartEntry> ChartData;
    private string ReceiptImageSrc = "";
    private bool IsReceiptModalVisible = false;
    private string ChartTitle = "";
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 10;
    private int TotalCount { get; set; }
    private bool IsLoading { get; set; }
    private QueryModel<DebtRecordDto> _lastQueryModel = new QueryModel<DebtRecordDto>(1, 1, 1, null, null);
    private async Task OnTableChange(QueryModel<DebtRecordDto> queryModel)
    {
        _lastQueryModel = queryModel;
        LoadDebtsAsync(queryModel);
    }
    private void RefreshTableAsync()
    {
        // Use the last query or a default one
        LoadDebtsAsync(_lastQueryModel ?? new QueryModel<DebtRecordDto>(1, 1, 1, null, null));
    }

    private void LoadDebtsAsync(QueryModel<DebtRecordDto> queryModel)
    {

    }
    protected override async Task OnInitializedAsync()
    {
        var report = await _settlementService.GetTripSettlementAsync(TripId);

        if (report is not null)
        {
            Debts = report.OptimizedDebts;
            ChartTitle = report.TripName;
            ChartData = new();

            foreach (var fam in report.Families)
            {
                ChartData.Add(new ChartEntry { FamilyName = fam.FamilyName, Amount = fam.TotalPaid, Category = "پرداختی" });
                ChartData.Add(new ChartEntry { FamilyName = fam.FamilyName, Amount = fam.TotalShare, Category = "سهم" });
            }
        }
    }

    private async Task ShowReceiptAsync(int debtId)
    {
        var result = await _debtRecordService.GetPaymentReceipt(debtId);
        if (!string.IsNullOrWhiteSpace(result))
        {
            ReceiptImageSrc = $"data:image/jpeg;base64,{result}";
            IsReceiptModalVisible = true;
        }
    }

    private async Task UploadReceiptAsync(InputFileChangeEventArgs e, int debtId)
    {
        var file = e.File;

        using var stream = file.OpenReadStream(long.MaxValue); // or a custom limit
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var base64 = Convert.ToBase64String(ms.ToArray());

        await _debtRecordService.UpdatePaymentReceipt(debtId, base64);

        await OnInitializedAsync(); // Reload the data

    }


    // Models


    public class ChartEntry
    {
        public string FamilyName { get; set; }
        public decimal Amount { get; set; }
        public string Category { get; set; }
    }
}
