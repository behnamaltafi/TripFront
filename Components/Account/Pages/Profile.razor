@page "/profile"
@using AntDesign
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using TripFront.Data
 @rendermode InteractiveServer
@inject IMessageService Message
<div class="profile-container">
    <div class="profile-header-card">
        <div class="profile-cover-wrapper">
            <div class="profile-cover">

            </div>

        </div>

        <div class="profile-info-section">
            <div class="avatar-wrapper">
                <Avatar Size="AvatarSize.Large" Src="@profileModel.AvatarUrl" Class="profile-avatar" />
                <Button Class="change-avatar-btn" Shape="@ButtonShape.Circle" Icon="@IconType.Outline.Camera" Size="ButtonSize.Large" />
            </div>

            <div class="profile-details">
                <h1 class="profile-name">@profileModel.Name</h1>
                <p class="profile-bio">@profileModel.Bio</p>

            </div>

            <Button Type="@ButtonType.Primary"
            Icon="@IconType.Outline.Edit"
            Class="edit-profile-btn"
            OnClick="EnableEdit"
            Shape="@ButtonShape.Round">
                ویرایش پروفایل
            </Button>
        </div>

    </div>

    <!-- Content Tabs -->
    <div class="profile-content">
        <Tabs DefaultActiveKey="1" Class="custom-tabs" TabBarGutter="32">
            <TabPane Tab="اطلاعات شخصی" Key="1">
                <div class="tab-content">
                    <Form Model="@profileModel"
                    Layout="@FormLayout.Vertical"
                    OnFinish="OnFinish"
                    OnFinishFailed="OnFinishFailed"
                    Class="profile-form">

                        <!-- Personal Info Section -->
                        <div class="form-section">
                            <h3 class="section-title">
                                <Icon Type="@IconType.Outline.User" /> اطلاعات پایه
                            </h3>
                            <Row Gutter="16">
                                <AntDesign.Col Xs="24" Sm="12">
                                    <FormItem Label="نام" Rules=@(new FormValidationRule[] { new FormValidationRule { Required = true, Message = "لطفا نام و نام خانوادگی خود را وارد کنید" } })>
                                        <Input @bind-Value="@context.Name"
                                        Disabled="@(!isEditing)"
                                        Size="@InputSize.Large" />
                                    </FormItem>
                                </AntDesign.Col>
                                <AntDesign.Col Xs="24" Sm="12">
                                    <FormItem Label="شماره کارت" Rules=@(new FormValidationRule[] { new FormValidationRule { Required = true, Message = "لطفا شماره کارت بانکی خود را وارد کنید" } })>
                                        <Input @bind-Value="@context.AccountNumber"
                                        Disabled="@(!isEditing)"
                                        Size="@InputSize.Large" />
                                    </FormItem>
                                </AntDesign.Col>
                            </Row>
                        </div>

                        <!-- Contact Section -->
                        <div class="form-section">
                            <h3 class="section-title">
                                <Icon Type="@IconType.Outline.Contacts" /> اطلاعات تماس
                            </h3>
                            <Row Gutter="16">
                                <AntDesign.Col Xs="24" Sm="12">
                                    <FormItem Label="ایمیل" Rules=@(new FormValidationRule[] {
                                              new FormValidationRule { Required = true, Message = "لطفا ایمیل خود را وارد کنید" },
                                              new FormValidationRule { Type = FormFieldType.Email, Message = "فرمت ایمیل صحیح نیست" }
                                              })>
                                        <Input @bind-Value="@context.Email"
                                        Disabled="@(!isEditing)"
                                        Size="@InputSize.Large" />
                                    </FormItem>
                                </AntDesign.Col>
                                <AntDesign.Col Xs="24" Sm="12">
                                    <FormItem Label="شماره تماس" Rules=@(new FormValidationRule[] {
                                              new FormValidationRule { Required = true, Message = "لطفا شماره تماس خود را وارد کنید" },
                                              new FormValidationRule { Pattern = "^09[0-9]{9}$", Message = "شماره تماس باید با 09 شروع شود و 11 رقم باشد" }
                                              })>
                                        <Input @bind-Value="@context.PhoneNumber"
                                        Disabled="@(!isEditing)"
                                        Size="@InputSize.Large" />
                                    </FormItem>
                                </AntDesign.Col>
                            </Row>
                        </div>

                        <!-- Bio Section -->
                        <div class="form-section">
                            <h3 class="section-title">
                                <Icon Type="@IconType.Outline.FileText" /> درباره من
                            </h3>
                            <FormItem>
                                <TextArea @bind-Value="@context.Bio"
                                Rows="4"
                                Disabled="@(!isEditing)"
                                ShowCount
                                MaxLength="200"
                                Placeholder="چند خط درباره خودتان بنویسید..." />
                            </FormItem>
                        </div>



                        <!-- Action Buttons -->
                        @if (isEditing)
                        {
                            <div class="form-actions">
                                <Button Type="@ButtonType.Primary"
                                HtmlType="submit"
                                Loading="@loading"
                                Size="@ButtonSize.Large"
                                Icon="@IconType.Outline.Save">
                                    ذخیره تغییرات
                                </Button>
                                <Button OnClick="CancelEdit"
                                Size="@ButtonSize.Large">
                                    انصراف
                                </Button>
                            </div>
                        }
                    </Form>
                </div>
            </TabPane>

            <TabPane Tab="امنیت" Key="2">
                <div class="tab-content">
                    <!-- Password Change Section -->
                    <div class="security-section">
                        <h3 class="section-title">
                            <Icon Type="@IconType.Outline.Lock" /> تغییر رمز عبور
                        </h3>
                        <Form Model="@securityModel" Layout="@FormLayout.Vertical" Class="security-form">
                            <FormItem Label="رمز عبور فعلی">
                                <InputPassword @bind-Value="@context.CurrentPassword"
                                Size="@InputSize.Large"
                                Placeholder="رمز عبور فعلی خود را وارد کنید" />
                            </FormItem>
                            <FormItem Label="رمز عبور جدید">
                                <InputPassword @bind-Value="@context.NewPassword"
                                Size="@InputSize.Large"
                                Placeholder="رمز عبور جدید را وارد کنید" />
                            </FormItem>
                            <FormItem Label="تکرار رمز عبور جدید">
                                <InputPassword @bind-Value="@context.ConfirmPassword"
                                Size="@InputSize.Large"
                                Placeholder="رمز عبور جدید را مجددا وارد کنید" />
                            </FormItem>
                            <FormItem>
                                <Button Type="@ButtonType.Primary"
                                OnClick="ChangePassword"
                                Size="@ButtonSize.Large"
                                Icon="@IconType.Outline.Key">
                                    تغییر رمز عبور
                                </Button>
                            </FormItem>
                        </Form>
                    </div>

                    <!-- Two Factor Auth Section -->
                    <div class="security-section">
                        <h3 class="section-title">
                            <Icon Type="@IconType.Outline.Safety" /> احراز هویت دو مرحله‌ای
                        </h3>
                        <div class="two-factor-card">
                            <div class="two-factor-info">
                                <Icon Type="@IconType.Outline.Safety" Class="security-icon" />
                                <div>
                                    <h4>افزایش امنیت حساب کاربری</h4>
                                    <p>با فعال‌سازی این قابلیت، علاوه بر رمز عبور، کد تایید نیز برای ورود نیاز خواهید داشت.</p>
                                </div>
                            </div>
                            <Switch @bind-Checked="@twoFactorEnabled"
                            OnChange="OnTwoFactorChange"
                            CheckedChildren="فعال"
                            UnCheckedChildren="غیرفعال" />
                        </div>
                    </div>
                </div>
            </TabPane>


        </Tabs>
    </div>
</div>



@code {
    [Inject] private IFamilyService _familyService { get; set; }
    [Inject] private UserManager<ApplicationUser> _userManager { get; set; }
    private ProfileModel profileModel = new ProfileModel();
    private SecurityModel securityModel = new SecurityModel();
    private bool isEditing = false;
    private bool loading = false;
    private bool twoFactorEnabled = false;

    protected override async Task OnInitializedAsync()
    {
        var currentfamily = _familyService.GetFamilyId();
        var info = await _familyService.Find(currentfamily);
        var avatar = await _familyService.GetProfileByFamilyId(currentfamily);
        var user = await _userManager.FindByIdAsync(info.UserId);
        profileModel = new ProfileModel
            {
                Name = info.Name,
                AccountNumber = info.AccountNumber,
                Email = user.Email,
                PhoneNumber = user.PhoneNumber,
                Bio = info.Bio,
                AvatarUrl = avatar,
                Interests = info.Interests
            };
    }

    private void EnableEdit()
    {
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        // Reset form to original values if needed
    }

    private async Task OnFinish(EditContext editContext)
    {
        loading = true;
        try
        {
            // Simulate API call
            await Task.Delay(1000);

            // Save profile data
            // await ProfileService.UpdateProfile(profileModel);

            await Message.Success("پروفایل با موفقیت بروزرسانی شد");
            isEditing = false;
        }
        catch
        {
            await Message.Error("خطا در بروزرسانی پروفایل");
        }
        finally
        {
            loading = false;
        }
    }

    private void OnFinishFailed(EditContext editContext)
    {
        Message.Error("لطفا فیلدهای مورد نیاز را تکمیل کنید");
    }

    private async Task ChangePassword()
    {
        if (securityModel.NewPassword != securityModel.ConfirmPassword)
        {
            await Message.Error("رمز عبور جدید با تکرار آن مطابقت ندارد");
            return;
        }

        // Implement password change logic
        await Task.Delay(1000);
        await Message.Success("رمز عبور با موفقیت تغییر یافت");
    }

    private void OnTwoFactorChange(bool enabled)
    {
        // Implement 2FA toggle logic
        Message.Info(enabled ? "احراز هویت دو مرحله‌ای فعال شد" : "احراز هویت دو مرحله‌ای غیرفعال شد");
    }

    private async Task SaveNotificationSettings()
    {
        // Save notification settings
        await Task.Delay(500);
        await Message.Success("تنظیمات اعلان‌ها ذخیره شد");
    }

    // Model Classes
    public class ProfileModel
    {
        [Required(ErrorMessage = "نام الزامی است")]
        public string Name { get; set; }

        [Required(ErrorMessage = "شماره کارت الزامی است")]
        public string AccountNumber { get; set; }

        [Required(ErrorMessage = "ایمیل الزامی است")]
        [EmailAddress(ErrorMessage = "فرمت ایمیل صحیح نیست")]
        public string Email { get; set; }

        [Required(ErrorMessage = "شماره تماس الزامی است")]
        [Phone(ErrorMessage = "فرمت شماره تماس صحیح نیست")]
        public string PhoneNumber { get; set; }

        public string Bio { get; set; }
        public string AvatarUrl { get; set; }
        public List<string> Interests { get; set; }

        // Stats
        public int TripsCount { get; set; }
        public int FriendsCount { get; set; }

    }

    public class SecurityModel
    {
        [Required(ErrorMessage = "رمز عبور فعلی الزامی است")]
        public string CurrentPassword { get; set; }

        [Required(ErrorMessage = "رمز عبور جدید الزامی است")]
        [MinLength(8, ErrorMessage = "رمز عبور باید حداقل 8 کاراکتر باشد")]
        public string NewPassword { get; set; }

        [Required(ErrorMessage = "تکرار رمز عبور الزامی است")]
        [Compare("NewPassword", ErrorMessage = "رمز عبور جدید با تکرار آن مطابقت ندارد")]
        public string ConfirmPassword { get; set; }
    }

   
}
<style>

    :root {
        --primary-color: #1890ff;
        --primary-dark: #096dd9;
        --secondary-color: #52c41a;
        --danger-color: #ff4d4f;
        --warning-color: #faad14;
        --text-primary: #262626;
        --text-secondary: #8c8c8c;
        --background: #f5f7fa;
        --card-background: #ffffff;
        --border-color: #e8e8e8;
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.12);
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-xl: 24px;
    }

    /* Global Styles - Same font family */
    * {
        font-family: 'Vazir', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* Profile Container */
    .profile-container {
        min-height: 100vh;
        background: var(--background);
    }

    /* Profile Header Card - Similar to hero section */
    .profile-header-card {
        position: relative;
        margin-bottom: -60px;
        overflow: hidden;
    }

    .profile-cover-wrapper {
        position: relative;
        height: 400px;
        overflow: hidden;
    }

    .profile-cover {
        position: absolute;
        inset: 0;
        background-image: url('https://source.unsplash.com/random/1920x600?nature,landscape');
        background-size: cover;
        background-position: center;
        filter: brightness(0.8);
    }

        .profile-cover::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(24, 144, 255, 0.9) 0%, rgba(9, 109, 217, 0.8) 100%);
        }

    /* Profile Info Section */
    .profile-info-section {
        position: relative;
        z-index: 1;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        align-items: flex-end;
        gap: 32px;
        transform: translateY(-80px);
    }

    /* Avatar Wrapper */
    .avatar-wrapper {
        position: relative;
        animation: fadeInUp 0.8s ease-out;
    }

    .profile-avatar {
        width: 150px !important;
        height: 150px !important;
        border: 6px solid var(--card-background);
        box-shadow: var(--shadow-lg);
        border-radius: 50%;
    }

    .change-avatar-btn {
        position: absolute;
        bottom: 5px;
        right: 5px;
        background: var(--primary-color) !important;
        border: 3px solid var(--card-background) !important;
        color: white !important;
        width: 40px !important;
        height: 40px !important;
        box-shadow: var(--shadow-md);
        transition: all 0.3s ease;
    }

        .change-avatar-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            background: var(--primary-dark) !important;
        }

    /* Profile Details */
    .profile-details {
        flex: 1;
        color: white;
        animation: fadeInUp 0.8s ease-out 0.2s both;
    }

    .profile-name {
        font-size: 48px;
        font-weight: 700;
        margin: 0 0 16px;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .profile-bio {
        font-size: 20px;
        font-weight: 300;
        margin: 0;
        opacity: 0.95;
    }

    /* Edit Profile Button - Same style as hero CTA */
    .edit-profile-btn {
        animation: fadeInUp 0.8s ease-out 0.4s both;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
        height: 48px !important;
        padding: 0 32px !important;
        font-size: 16px !important;
        background: var(--primary-color) !important;
        border-color: var(--primary-color) !important;
        transition: all 0.3s ease;
    }

        .edit-profile-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
            background: var(--primary-dark) !important;
        }

    /* Stats Section - Similar to main page */
    .profile-stats {
        position: relative;
        z-index: 1;
        margin-bottom: 32px;
        transform: translateY(-40px);
    }

    .stats-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 24px;
    }

    .stat-item {
        background: var(--card-background);
        border-radius: var(--radius-lg);
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: var(--shadow-md);
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .stat-item:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }

    .stat-icon {
        font-size: 32px;
        color: var(--primary-color);
        background: rgba(24, 144, 255, 0.1);
        padding: 12px;
        border-radius: var(--radius-md);
    }

    .stat-info {
        display: flex;
        flex-direction: column;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
    }

    .stat-label {
        font-size: 14px;
        color: var(--text-secondary);
        margin-top: 4px;
    }

    /* Profile Content - Similar to trips content */
    .profile-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px 32px;
    }

    /* Custom Tabs */
    .custom-tabs {
        background: var(--card-background);
        border-radius: var(--radius-lg);
        padding: 24px;
        box-shadow: var(--shadow-sm);
        animation: fadeIn 0.6s ease-out;
    }

        .custom-tabs .ant-tabs-nav {
            margin-bottom: 24px;
        }

        .custom-tabs .ant-tabs-tab {
            font-size: 16px;
            font-weight: 500;
            padding: 12px 24px;
            color: var(--text-secondary);
            transition: all 0.3s ease;
        }

            .custom-tabs .ant-tabs-tab:hover {
                color: var(--primary-color);
            }

        .custom-tabs .ant-tabs-tab-active {
            color: var(--primary-color);
        }

        .custom-tabs .ant-tabs-ink-bar {
            background: var(--primary-color);
            height: 3px;
        }

    /* Tab Content */
    .tab-content {
        padding: 32px 0;
    }

    /* Form Section */
    .form-section {
        background: var(--background);
        border-radius: var(--radius-lg);
        padding: 32px;
        margin-bottom: 32px;
        border: 1px solid var(--border-color);
        transition: all 0.3s ease;
    }

        .form-section:hover {
            box-shadow: var(--shadow-sm);
        }

    .section-title {
        font-size: 20px;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 24px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .section-title .anticon {
            color: var(--primary-color);
        }

    /* Form Items */
    .profile-form .ant-form-item-label > label {
        font-weight: 500;
        color: var(--text-secondary);
    }

    .profile-form .ant-input,
    .profile-form .ant-input-password,
    .profile-form .ant-input-textarea textarea {
        border-radius: var(--radius-sm);
        font-size: 16px;
        padding: 10px 16px;
        border-color: var(--border-color);
        transition: all 0.3s ease;
    }

        .profile-form .ant-input:hover,
        .profile-form .ant-input-password:hover,
        .profile-form .ant-input-textarea textarea:hover {
            border-color: var(--primary-color);
        }

        .profile-form .ant-input:focus,
        .profile-form .ant-input-password:focus,
        .profile-form .ant-input-textarea textarea:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 2px rgba(24, 144, 255, 0.2);
        }

        .profile-form .ant-input[disabled] {
            background: var(--background);
            color: var(--text-secondary);
        }

    /* Form Actions */
    .form-actions {
        display: flex;
        gap: 16px;
        margin-top: 32px;
    }

        .form-actions .ant-btn {
            height: 48px;
            padding: 0 32px;
            font-size: 16px;
            font-weight: 500;
            border-radius: var(--radius-sm);
            transition: all 0.3s ease;
        }

        .form-actions .ant-btn-primary {
            background: var(--primary-color);
            border-color: var(--primary-color);
            box-shadow: var(--shadow-sm);
        }

            .form-actions .ant-btn-primary:hover {
                background: var(--primary-dark);
                transform: translateY(-2px);
                box-shadow: var(--shadow-md);
            }

    /* Security Section */
    .security-section {
        background: var(--background);
        border-radius: var(--radius-lg);
        padding: 32px;
        margin-bottom: 32px;
        border: 1px solid var(--border-color);
    }

    .security-form {
        max-width: 600px;
    }

    /* Two Factor Card */
    .two-factor-card {
        background: var(--card-background);
        border-radius: var(--radius-lg);
        padding: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
    }

        .two-factor-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-2px);
        }

    .two-factor-info {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        flex: 1;
    }

    .security-icon {
        font-size: 32px;
        color: var(--primary-color);
        background: rgba(24, 144, 255, 0.1);
        padding: 12px;
        border-radius: var(--radius-md);
    }

    .two-factor-info h4 {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 8px;
    }

    .two-factor-info p {
        font-size: 14px;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.6;
    }

    /* Animations - Same as main page */
    @@keyframes fadeIn {
        from

    {
        opacity: 0;
    }

    to {
        opacity: 1;
    }

    }

    @@keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes scaleIn {
        from

    {
        opacity: 0;
        transform: scale(0.9);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

    }

    /* Mobile Responsive - Following main page pattern */
    @@media (max-width: 768px) {
        .profile-cover-wrapper

    {
        height: 300px;
    }

    .profile-info-section {
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0 16px;
        transform: translateY(-60px);
    }

    .profile-avatar {
        width: 120px !important;
        height: 120px !important;
    }

    .profile-name {
        font-size: 32px;
    }

    .profile-bio {
        font-size: 16px;
    }

    .stats-container {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        padding: 0 16px;
    }

    .stat-item {
        padding: 16px;
    }

    .stat-icon {
        font-size: 24px;
        padding: 8px;
    }

    .stat-value {
        font-size: 20px;
    }

    .profile-content {
        padding: 0 16px 32px;
    }

    .form-section,
    .security-section {
        padding: 24px;
    }

    .form-actions {
        flex-direction: column;
    }

        .form-actions .ant-btn {
            width: 100%;
        }

    .two-factor-card {
        flex-direction: column;
        text-align: center;
        gap: 16px;
    }

    .two-factor-info {
        flex-direction: column;
        align-items: center;
    }

    .edit-profile-btn {
        display: none;
    }

    }

    @@media (max-width: 480px) {
        .profile-name

    {
        font-size: 28px;
