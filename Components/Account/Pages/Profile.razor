				TripsCount = info.Trips,
				FriendsCount = info.Friends,
				Interests = info.Interests
			};

		notificationModel = new NotificationModel
			{
				EmailNotifications = true,
				TripReminders = true,
				FriendRequests = false,
				TripInvitations = true
			};
