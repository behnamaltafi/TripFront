@page "/Account/Login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authentication
@using TripFront.Data
@using AntDesign
@using System.Security.Claims
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject UserManager<ApplicationUser> UserManager

<PageTitle>ورود - دونگچی</PageTitle>

@* Link to the theme CSS file *@
<link href="/css/theme.css" rel="stylesheet" />

<style>
    /* Page-specific styles that extend the theme */
    .login-logo {
        width: 120px;
        height: 120px;
        margin: 0 auto var(--spacing-xl);
        background: rgba(255, 255, 255, 0.2);
        border-radius: var(--radius-xxl);
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(10px);
        box-shadow: var(--shadow-lg);
    }
    
    .login-content {
        position: relative;
        z-index: 1;
        text-align: center;
        color: white;
        max-width: 800px;
    }

    .login-title {
        font-size: var(--font-size-xxxxl);
        font-weight: 700;
        color: white;
        margin-bottom: var(--spacing-lg);
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
    }

    .login-subtitle {
        font-size: var(--font-size-xl);
        line-height: 1.8;
        opacity: 0.95;
        margin-bottom: var(--spacing-xxl);
    }

    .login-form-wrapper {
        width: 100%;
        max-width: 420px;
    }

    .password-toggle-icon {
        position: absolute;
        left: var(--spacing-md);
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: var(--text-light);
        font-size: var(--font-size-lg);
        z-index: 2;
    }

    .remember-forgot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-xl);
    }

    .social-section {
        display: flex;
        gap: var(--spacing-md);
    }

    .signup-prompt {
        text-align: center;
        margin-top: var(--spacing-xl);
        padding-top: var(--spacing-xl);
        border-top: 1px solid var(--border-lighter);
        font-size: var(--font-size-sm);
        color: var(--text-secondary);
    }

    .error-alert {
        margin-top: var(--spacing-md);
        border-radius: var(--radius-md);
    }
</style>

<div class="container-full">
    <!-- Left Side - Feature Showcase -->
    <div class="showcase-section animated-bg">
        <div class="login-content">
            <div class="login-logo">
                <Icon Type="@IconType.Outline.Compass" Theme="IconThemeType.Outline" Style="font-size: 48px; color: white;" />
            </div>

            <h1 class="login-title">دونگچی</h1>
            <p class="login-subtitle">
                مدیریت هوشمند هزینه‌های سفر خانوادگی
            </p>

            <div style="display: flex; flex-direction: column; gap: var(--spacing-lg); text-align: right;">
                <div class="feature-item">
                    <div class="feature-icon-box">
                        <Icon Type="@IconType.Outline.Calculator" />
                    </div>
                    <div class="feature-content">
                        <h4>محاسبه دقیق هزینه‌ها</h4>
                        <p>تقسیم عادلانه و شفاف بین اعضای سفر</p>
                    </div>
                </div>

                <div class="feature-item">
                    <div class="feature-icon-box">
                        <Icon Type="@IconType.Outline.Team" />
                    </div>
                    <div class="feature-content">
                        <h4>مدیریت گروهی</h4>
                        <p>افزودن اعضای خانواده و دوستان به سفر</p>
                    </div>
                </div>

                <div class="feature-item">
                    <div class="feature-icon-box">
                        <Icon Type="@IconType.Outline.PieChart" />
                    </div>
                    <div class="feature-content">
                        <h4>گزارش‌های جامع</h4>
                        <p>نمودارها و آمار دقیق از هزینه‌ها</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side - Login Form -->
    <div class="form-section">
        <div class="login-form-wrapper">
            <div class="card-header mb-5">
                <h2 class="card-title">خوش آمدید</h2>
                <p class="card-subtitle">برای ادامه وارد حساب کاربری خود شوید</p>
            </div>

            <div class="card card-bordered">
            <Form Method="HttpMethod.Post" Model="@Input" OnFinish="LoginUser" Name="login">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label class="form-label">نام کاربری یا ایمیل</label>
                        <div class="input-wrapper">
                            <Icon Type="@IconType.Outline.User" Class="input-icon" />
                            <Input @bind-Value="Input.UserName"
                                   Placeholder="example@email.com"
                                   Size="@InputSize.Large" />
                        </div>
                        <ValidationMessage For="@(() => Input.UserName)" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">رمز عبور</label>
                        <div class="input-wrapper">
                            <Icon Type="@(_showPassword ? IconType.Outline.EyeInvisible : IconType.Outline.Eye)"
                                  OnClick="@TogglePasswordVisibility"
                                  Class="password-toggle-icon"
                                  AriaLabel="تغییر نمایش رمز" />
                            <Icon Type="@IconType.Outline.Lock" Class="input-icon" />
                            <Input Type="@(_showPassword ? InputType.Text : InputType.Password)"
                                   @bind-Value="Input.Password"
                                   Placeholder="رمز عبور خود را وارد کنید"
                                   Size="@InputSize.Large" />
                        </div>
                        <ValidationMessage For="@(() => Input.Password)" />
                    </div>

                    <div class="remember-forgot">
                        <Checkbox @bind-Value="Input.RememberMe">مرا به خاطر بسپار</Checkbox>
                        <a href="/Account/ForgotPassword">رمز عبور را فراموش کرده‌اید؟</a>
                    </div>

                    <Button Type="@ButtonType.Primary"
                            HtmlType="submit"
                            Class="btn btn-primary btn-block"
                            Loading="@isLoading"
                            Icon="@IconType.Outline.Login">
                        ورود 
                    </Button>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <Alert Message="@errorMessage"
                               Type="@AlertType.Error"
                               ShowIcon="true"
                               Closable="true"
                               Class="error-alert" />
                    }
                </Form>

                <div class="divider">
                    <div class="divider-line"></div>
                    <span class="divider-text">یا</span>
                </div>

                <div class="social-section">
                    <Button Class="btn btn-secondary btn-block">
                    
                        <svg style="margin-bottom:-2px" xmlns="http://www.w3.org/2000/svg" width="25" height="15" viewBox="0 0 24 24"><defs><radialGradient id="prefix__b" cx="1.479" cy="12.788" fx="1.479" fy="12.788" r="9.655" gradientTransform="matrix(.8032 0 0 1.0842 2.459 -.293)" gradientUnits="userSpaceOnUse"><stop offset=".368" stop-color="#ffcf09" /><stop offset=".718" stop-color="#ffcf09" stop-opacity=".7" /><stop offset="1" stop-color="#ffcf09" stop-opacity="0" /></radialGradient><radialGradient id="prefix__c" cx="14.295" cy="23.291" fx="14.295" fy="23.291" r="11.878" gradientTransform="matrix(1.3272 0 0 1.0073 -3.434 -.672)" gradientUnits="userSpaceOnUse"><stop offset=".383" stop-color="#34a853" /><stop offset=".706" stop-color="#34a853" stop-opacity=".7" /><stop offset="1" stop-color="#34a853" stop-opacity="0" /></radialGradient><linearGradient id="prefix__d" x1="23.558" y1="6.286" x2="12.148" y2="20.299" gradientUnits="userSpaceOnUse"><stop offset=".671" stop-color="#4285f4" /><stop offset=".885" stop-color="#4285f4" stop-opacity="0" /></linearGradient><clipPath id="prefix__a"><path d="M22.36 10H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53h-.013l.013-.01c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09c.87-2.6 3.3-4.53 6.16-4.53 1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07 1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93v.01C3.99 20.53 7.7 23 12 23c2.97 0 5.46-.98 7.28-2.66 2.08-1.92 3.28-4.74 3.28-8.09 0-.78-.07-1.53-.2-2.25z" fill="none" /></clipPath></defs><path d="M22.36 10H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53h-.013l.013-.01c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09c.87-2.6 3.3-4.53 6.16-4.53 1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07 1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93v.01C3.99 20.53 7.7 23 12 23c2.97 0 5.46-.98 7.28-2.66 2.08-1.92 3.28-4.74 3.28-8.09 0-.78-.07-1.53-.2-2.25z" fill="#fc4c53" /><g clip-path="url(#prefix__a)"><ellipse cx="3.646" cy="13.572" rx="7.755" ry="10.469" fill="url(#prefix__b)" /><ellipse cx="15.538" cy="22.789" rx="15.765" ry="11.965" transform="rotate(-7.12 15.539 22.789)" fill="url(#prefix__c)" /><path fill="url(#prefix__d)" d="M11.105 8.28l.491 5.596.623 3.747 7.362 6.848 8.607-15.897-17.083-.294z" /></g></svg>
                        Google
                    </Button>
                </div>

                <div class="signup-prompt">
                    حساب کاربری ندارید؟ <a href="/Account/Register">ثبت‌نام کنید</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isLoading = false;
    private bool _showPassword = false;

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext?.Request?.Method))
        {
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    public async Task LoginUser()
    {
        var result = await SignInManager.PasswordSignInAsync(Input.UserName, Input.Password, Input.RememberMe, false);

        if (result.Succeeded)
        {
            var user = await UserManager.FindByNameAsync(Input.UserName);
            Logger.LogInformation("ورود موفق.");
            if (ReturnUrl == null || ReturnUrl == "")
            {
                RedirectManager.RedirectTo("/");
            }
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo("Account/LoginWith2fa", new()
                {
                    ["returnUrl"] = ReturnUrl,
                    ["rememberMe"] = Input.RememberMe
                });
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("اکانت قفل شده.");
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            errorMessage = "ورود نامعتبر. لطفاً اطلاعات را بررسی کنید.";
        }
    }
    private sealed class InputModel
    {
        [Required(ErrorMessage = "نام کاربری الزامی است.")]
        [Display(Name = "نام کاربری")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "رمز عبور الزامی است.")]
        [DataType(DataType.Password)]
        [Display(Name = "رمز عبور")]
        public string Password { get; set; } = "";

        [Display(Name = "مرا به خاطر بسپار")]
        public bool RememberMe { get; set; }
    }
}